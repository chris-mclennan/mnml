#!/bin/sh
# tools/shims/unzip — the `unzip` the .test corpus sees (Linux arm of the
# wizard's Nerd Font install). Prints and exits 0.
# `MNML_SHIM_SLEEP=<secs>` keeps the process alive that long first, so a
# script can see the pane before it exits.
[ -n "${MNML_SHIM_SLEEP:-}" ] && sleep "$MNML_SHIM_SLEEP"
echo "unzip (shim): $*"
exit 0
