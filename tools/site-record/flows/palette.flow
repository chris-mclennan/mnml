title: The command palette
flow: Every command has a palette row: the palette filters as you type, Ctrl+P finds a file, and the theme picker previews NvChad's themes live.
open src/main.zig
until "fn main"
record
wait 600
key ctrl+shift+p
wait 300
slowtype "git" 90
wait 600
keys @220 down down down down down
wait 500
key esc
wait 400
key ctrl+p
wait 300
slowtype "util" 80
wait 500
key enter
until "pub fn sum"
wait 900
key ctrl+shift+p
wait 250
slowtype "pick theme" 50
wait 400
key enter
wait 700
slowtype "catpp" 90
wait 700
poster
keys @900 down up
wait 500
key enter
wait 1200
