title: The terminal pane
flow: A shell in a split, rendered by libghostty: colour output, a git graph, and a full-screen program running inside the pane.
open src/main.zig
until "fn main"
record
wait 900
run term.shell
until "tour %" 4000
wait 600
slowtype "ls -G src docs\n" 50
wait 1200
slowtype "git log --graph --oneline --color\n" 40
wait 2200
poster
slowtype "vi src/util.zig\n" 50
wait 2200
keys @120 j j j j j j
wait 800
slowtype ":q\n" 120
wait 1200
slowtype "echo done\n" 60
wait 1500
