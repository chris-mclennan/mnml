.{
    .jira_url = "http://127.0.0.1:PORT",
    .email = "fake@acme.com",
    .refresh_interval_secs = 0,
    // The fake's own forge corner. Without this the default is
    // api.bitbucket.org, so expanding a PR row in a dump run left the
    // machine and 401'd against the real Bitbucket.
    .bitbucket_api_url = "http://127.0.0.1:PORT/2.0",
    .team_field_id = "customfield_10056",
    .team_field_name = "Team",
    .tabs = .{
        .{ .name = "Assigned", .kind = .work_assigned },
        .{ .name = "Recently Done", .kind = .work_recently_done },
        .{ .name = "Current Release", .kind = .fix_version_tree, .project = "ENG", .mode = .current_release, .status_order = .{ "Testing", "In PR Review", "In Progress", "To Do", "Done" }, .bumps = .{ .pr_approved = "Testing", .no_open_prs = "Testing" } },
        .{ .name = "Sprint", .kind = .board_active_sprint, .project = "ENG", .board_id = 7 },
        .{ .name = "Backlog", .kind = .board_backlog, .project = "ENG" },
    },
}
