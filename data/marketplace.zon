// The mnml catalogue — the integrations this repo builds, listed as the
// `mnml` source (a dev build's default; a released mnml lists its
// release index first, and a row both carry installs from the index).
// `tools/integrations_index.zig` also reads each row's label,
// description, docs and chip into a release's `integrations.json`. One entry per binary, not
// per manifest: `mnml-jira --install` writes three manifests, so Jira
// is one row here and three chips once installed.
//
// Adding a shipped integration is this file plus the folder under
// `integrations/` (CONTRIBUTING.md, "Adding a shipped integration").
// A unit test in `src/app/marketplace_catalogue.zig` holds every entry
// against the manifests in that folder, so the version and the binary
// name here cannot drift from what `--install` writes.
//
// A third party publishes the same shape from their own repo — see
// docs/SDK.md, "Publishing an integration".
.{
    .entries = .{
        .{
            .id = "jira",
            .label = "Jira",
            .description = "Jira: work, boards and fix versions — three chips on one binary",
            .category = "tracker",
            .version = "0.2.0",
            .binary = "mnml-jira",
            .docs = "https://github.com/chris-mclennan/mnml-zig/tree/main/integrations/jira",
            .chip = .{ .glyph = "\u{f0303}", .fallback = "J", .color = "blue" }, // nf-md-jira
        },
        .{
            .id = "bitbucket",
            .label = "Bitbucket",
            .description = "Bitbucket: pull requests and pipelines across the workspace",
            .category = "forge",
            .version = "0.2.0",
            .binary = "mnml-bitbucket",
            .docs = "https://github.com/chris-mclennan/mnml-zig/tree/main/integrations/bitbucket",
            .chip = .{ .glyph = "\u{f00a8}", .fallback = "B", .color = "blue" }, // nf-md-bitbucket
        },
        .{
            .id = "sample",
            .label = "Sample",
            .description = "The mnml-sdk sample: a live counter that answers keys and clicks",
            .category = "sample",
            .version = "0.1.0",
            .binary = "mnml-sample",
            .docs = "https://github.com/chris-mclennan/mnml-zig/tree/main/integrations/sample",
            .chip = .{ .glyph = "\u{f0c3}", .fallback = "S", .color = "teal" }, // nf-fa-flask
        },
    },
}
