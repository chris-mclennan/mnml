.zig-cache/
zig-out/
zig-pkg/
.DS_Store

# Workspace state stays local; the hunt findings are the record.
.mnml/*
!.mnml/findings/

# The navigation fixture is regenerated by tools/gen-large-fixture.py (314 KB).
docs/ui-spec/fixtures/large.rs

# tools/compare.sh keeps every step's screen and status.json (≈11 MB a
# set); the per-run diff.md / timing.md / *.json summaries are committed.
docs/research/compare/*/step-*
docs/research/compare/*/*.log
docs/research/compare/*/fixture.txt
__pycache__/
*.pyc

# tools/linux-verify.sh: the Zig tarball cache and the Linux run logs.
.verify/

# tools/tour.sh: the corpus sweep's baselines are machine-local (fonts,
# display profile) and ~1000 PNGs — never committed. The curated tour's
# baselines under tests/tour/baseline/ are.
tests/tour/sweep-baseline/

# the HTTP pane's request history — workspace state, never source
.rqst/
