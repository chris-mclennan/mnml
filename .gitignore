/target
scratchpad/
.mnml/
# The demo workspace's .mnml/ carries the demo-scope integration
# overrides + sample findings — those SHIP with mnml. Only the
# runtime scratch (session.json, ipc/) is filtered, via demo/.gitignore.
!demo/workspace/.mnml/
.claude/settings.local.json
.claude/cache/
.DS_Store
.local/
.claude/scheduled_tasks.lock
.claude/state/
.claude/coordination/

# libghostty-vt prebuilts — the .a / .so / .dylib files are too
# big to ship in git (37MB across 3 targets). They live on a
# GitHub release; fetch with vendor/libghostty-vt/fetch-prebuilts.sh
# (idempotent — CI + local devs run it once before cargo build).
/vendor/libghostty-vt/**/*.a
/vendor/libghostty-vt/**/*.dylib
/vendor/libghostty-vt/**/*.so
/vendor/libghostty-vt/**/*.so.*
/vendor/libghostty-vt/out/

# Findings / QA-sweep reports are private now — the historical `findings/`
# archive (2026-06 → 2026-07) lives under `.findings/archive-2026-07/`.
# Anything written to either path stays local.
findings/
.findings/
# Demo-workspace fictitious findings ship with mnml (they seed the
# `.mnml/findings/*.md` viewer in demo mode). Everything else under
# `findings/` remains local.
!demo/workspace/.mnml/findings/

# Throwaway sibling-config HOME + token stubs generated at record
# time by demo/tapes/hero.record.sh so the Jira / Bitbucket siblings
# hit the mock server instead of the developer's real Atlassian.
# Regenerated on every `./run.sh demo-record` — don't commit.
demo/tapes/.sibling-home/
demo/tapes/sibling-tokens/

# Per-frame PNG output from tape recordings (~200KB × N frames).
# Regenerated from the .cast files via the recording pipeline — not
# a source artifact. The rendered .gif is what ships.
demo/tapes/frames/
