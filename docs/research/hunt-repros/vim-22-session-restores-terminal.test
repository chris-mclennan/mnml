# Finding 22: session restore re-spawns terminal panes at launch.
# Neovim's :mksession does not restore :terminal buffers as live shells.
# requires: macos
write notes.txt "alpha\n"
open notes.txt
command editor.use_vim
command term.shell_bottom
wait 2000
expect screen contains "TERMINAL"
command session.save
expect file .mnml/session.zon lacks "zsh"
