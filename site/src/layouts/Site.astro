---
// Every page's <html>: fonts (self-hosted from npm), the stylesheet, and
// the theme — dark unless the visitor picked light, applied before
// first paint so there is no flash.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
const { title, description = "", chrome = true, current = Astro.url.pathname } = Astro.props;
// A title that already names mnml ("mnml Docs", "About mnml") stands
// alone, as ghostty.org's "Ghostty Docs" does.
const full = /\bmnml\b/.test(title) ? title : `${title} – mnml`;
// og.png is build output of scripts/prepare.mjs (from the hero poster);
// the PNG icons are committed renders of favicon.svg. Each is named only
// when it is there.
import fs from "node:fs";
import path from "node:path";
const built = (f) => fs.existsSync(path.resolve("public", f));
const og = built("og.png") ? new URL("/og.png", Astro.site ?? Astro.url).href : null;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={full} />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#0f0f11" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {built("favicon-32.png") && <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />}
    {built("apple-touch-icon.png") && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mnml" />
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    {og && <meta property="og:image:alt" content="A frame from a recording of mnml, the terminal IDE, in NvChad's chrome." />}
    <meta name="twitter:card" content={og ? "summary_large_image" : "summary"} />
    <slot name="head" />
    <script is:inline>
      try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch {}
    </script>
  </head>
  <body>
    {chrome && <Navbar current={current} />}
    <slot />
    {chrome && <Footer />}
  </body>
</html>
