# Demo workspace ships as a live git repo (10 fictional commits +
# 2 feature branches). We check in the files but not workspace/.git
# — mnml's own repo history shouldn't shadow the demo repo's, and
# a nested .git/ inside a tracked dir is a git-add footgun. The
# fictional history is packaged as `workspace-git.tar.gz` and
# extracted into the cache copy at `mnml --demo` boot time (see
# `resolve_demo_workspace` in src/main.rs).
workspace/.git/

# Scratch data mnml writes into the demo workspace at runtime.
workspace/.mnml/session.json
workspace/.mnml/last-session.json
workspace/.mnml/ipc/
# `mnml` auto-adds this file to newly-seen workspaces on first launch.
# It's meant for the demo workspace's own git repo, not the outer mnml
# repo — filter here so ./run.sh demo doesn't dirty git status.
workspace/.gitignore
