# zig-only
# `ui.menu_bar = always` (the default) paints File / Edit / View / Go /
# Help on the palette-bar row; a click drops the menu. The View menu's
# auto-equalize row flips ui.auto_equalize_splits.
write a.txt alpha
open a.txt
expect screen contains " File "
expect screen contains " Help "
click 5 0
expect screen contains "╭ File"
expect screen contains "New file"
expect screen contains "Reopen closed tab"
key esc
expect screen lacks "╭ File"
command view.toggle_auto_equalize_splits
expect screen contains "auto-equalize splits: on"
command view.menu_bar_cycle
expect screen contains "menu bar: auto"
expect screen lacks " File "
command view.menu_bar_open
expect screen contains " File "
expect screen contains "╭ File"
key esc
expect screen lacks " File "
