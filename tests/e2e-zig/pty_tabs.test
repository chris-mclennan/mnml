# zig-only
# Pty panes on the strip, painted as Rust paints them: `  <label> 󰅖 `
# like any tab, no divider, no `$`. `:bn` skips pty tabs, `:bn!` does
# not; `:rename` retitles; the scratch terminal toggles; a click on a
# pty tab's `󰅖` kills it.
write a.txt "alpha\n"
open a.txt
command view.toggle_tree
ex term sleep 30
expect screen contains "sleep 30 󰅖"
expect pane sleep 30
drag 2 20 12 1
expect screen contains " 󰈙 a.txt 󰅖    sleep 30 󰅖   󰐕"
expect pane sleep 30
ex bn
expect pane a.txt
ex bn
expect pane a.txt
ex bn!
expect pane sleep 30
ex rename build
expect screen contains "build 󰅖"
expect pane build
command term.scratch_toggle
expect pane scratch
expect screen contains "scratch 󰅖"
command term.scratch_toggle
expect screen lacks "scratch 󰅖"
expect pane build
command term.scratch_toggle
expect pane scratch
click 21 1
expect screen lacks "build 󰅖"
