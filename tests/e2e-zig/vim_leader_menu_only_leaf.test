# zig-only
# A leader chord resolves on its second key however fast it is typed —
# including the entries that exist only in the which-key menu, not in
# the keymap: `space n` toggles line numbers (never runs `n` as
# search-next), `space w` saves, and `space s v` splits right through
# the `+split` group. Typed as one `type` step the keys arrive back to
# back, with no tick between them.
write b.zig "const std = @import(\"std\");\n"
open b.zig
command editor.use_vim
expect screen contains "   1 const"

type " n"
expect screen lacks "   1 const"
expect screen lacks "no active find"
type " n"
expect screen contains "   1 const"
type x
expect dirty true
type " w"
expect dirty false
expect file b.zig contains "onst std"
type " sv"
wait 100
expect screen contains "b.zig"
key ctrl+w
key l
key ctrl+w
key q
