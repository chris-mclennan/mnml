# zig-only
# The tree's delete confirm: enter takes the default choice — Delete (to
# the trash) — and toasts, the way every other confirm answers enter.
write a.txt "aa"
command view.focus_tree
key r
key end
command file.delete
expect screen contains "Delete a.txt? It goes to the trash."
key enter
expect screen contains "deleted a.txt"
expect screen lacks "a.txt?"
