# zig-only
# The commit graph's detail panel (src/ui/git_graph_view.zig): enter on
# a commit opens it with the message and the file list; j moves the
# cursor and the panel follows; tab hands it the focus; `s` sorts by
# the next column and the chip says so; `/` jumps by hash prefix; a
# dirty tree puts the WIP row with its buttons first.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write a.txt "one\n"
shell git add a.txt
shell git commit -q -m "first commit"
write b.txt "two\n"
shell git add b.txt
shell git commit -q -m "second commit"
command git.graph
expect screen contains "2 commits"
expect screen contains "GRAPH"
expect screen contains "second commit"
expect screen contains "first commit"
# Enter: the detail panel for the selected (newest) commit.
key enter
wait 300
expect screen contains "files (1)"
expect screen contains "A b.txt"
# Down: the panel follows the cursor.
key j
wait 300
expect screen contains "A a.txt"
expect screen lacks "A b.txt"
# Tab focuses the panel; esc hands the focus back; esc closes it.
key tab
key esc
key esc
expect screen lacks "files (1)"
# Sort by date: the chip carries the arrow; the lanes fold to a dot.
key s
expect screen contains "DATE ▼"
key s
expect screen contains "AUTHOR ▼"
key s
key s
expect screen lacks "▼"
# A dirty tree: the WIP row and its buttons lead the list.
write c.txt "three\n"
command git.refresh
wait 500
command git.graph
expect screen contains "WIP @ main"
expect screen contains "[stage all]"
expect screen contains "[commit…]"
