# zig-only
# `files.open_split` puts a second browser beside the focused one — one
# new pane (VS Code's Split Editor Right is +1). It used to open a
# duplicate tab in the current group as well as the split.
write sub/a.txt "a"
command files.open
key enter
expect screen contains "› sub"
command files.open_split
# Each group's strip shows one `sub` tab; the duplicate would sit beside it.
expect screen lacks "sub   sub"
expect screen contains "sub   󰐕"
