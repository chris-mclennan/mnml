# zig-only
# width: 120
# The chrome row (src/ui/menu_bar.zig) as the Rust editor paints it at
# 120 columns: ` ❯_  mnml  File  Edit  » ` at the left, the search chip
# centred, the right cluster at the far right; the strip's + at column
# 32 beside the sidebar. A click on the chip opens the palette, on the
# + a scratch buffer, on a word its menu (rows carry chord hints), on
# the » the menus that did not fit.
expect screen contains " ❯_  mnml  File  Edit  » "
expect screen contains "󰍉  mnml-e2e-"
click 50 0
expect screen contains "Command palette"
key esc
expect screen lacks "Command palette"
click 32 1
expect pane "[scratch]"
click 12 0
expect screen contains "╭ File"
expect screen contains "Open recent file"
expect screen contains "ctrl+s"
click 14 11
expect screen lacks "╭ File"
expect screen lacks "[scratch]"
click 23 0
expect screen contains "Selection"
expect screen contains "Terminal"
expect screen contains "Window"
click 26 3
expect screen contains "╭ View"
expect screen contains "Toggle left panel"
key esc
expect screen lacks "╭ View"
