# The Jira integration (integrations/jira/, built beside the exe as
# $MNML_JIRA) installed from a Dev folder and mounted as a pane, against
# the offline server beside it ($MNML_FAKE_JIRA): no network, no real
# Atlassian site, no token but the fake one.
#
# The workspace is an SDK checkout (it has sdk/mnml-sdk), so its
# integrations/ is a dev root by itself; the folder's manifest.zon names
# the prebuilt binary, so Install skips the build. The pane then reads
# <workspace>/.mnml/integrations/jira/config.zon, searches the fake Jira
# and paints the epic → story → sub-task tree with its detail pane.
# env: JIRA_API_TOKEN=fake-token
shell "$MNML_FAKE_JIRA" --port 18719 --life-secs 180 --quiet --pid-file fake-jira.pid >/dev/null 2>&1 &
wait 500
write sdk/mnml-sdk/build.zig ""
write integrations/jira/build.zig ""
write integrations/jira/manifest.zon ".{ .id = \"jira\", .label = \"Jira\", .version = \"0.1.0\", .binary = \"$MNML_JIRA\", .category = \"tracker\", .commands = .{ .{ .id = \"jira.open\", .title = \"Jira: tickets\" } }, .statusline = .{ .{ .id = \"jira\", .text = \"JIRA\", .click_command = \"jira.open\" } } }"
write .mnml/integrations/jira/config.zon ".{ .jira = .{ .url = \"http://127.0.0.1:18719\", .email = \"fake@acme.com\" }, .mnml = .{ .refresh_interval_secs = 0 }, .tabs = .{ .{ .name = \"Mine\", .kind = .work_assigned }, .{ .name = \"All\", .kind = .custom, .jql = \"project = ENG ORDER BY rank\" } } }"
# Install it from the Dev tab, the way the sample's script does.
command integrations.show_in_dev
expect screen contains "INTEGRATIONS"
drag 30 5 60 5
expect screen contains "[dev] Jira  0.1.0  not installed"
key i
expect screen contains "installed jira from"
command integrations.show_installed
expect screen contains "Jira  0.1.0"
expect screen contains "jira.open"
# The pane mounts, searches the fake Jira and paints.
command jira.open
# Close the INTEGRATIONS section so the pane has the whole window.
command view.toggle_tree
command view.focus_pane
expect screen contains "JIRA"
expect screen contains "1 Mine"
expect screen contains "2 All"
# `work_assigned` is ENG-1, ENG-2 and ENG-5 — ENG-3 is unassigned and
# ENG-4 is Sam's and done.
expect screen contains "Mine"
expect screen contains "ENG-1"
expect screen contains "Checkout rewrite"
expect screen contains "ENG-2"
expect screen lacks "ENG-3"
# The detail pane is beside the list, on the selected ticket.
expect screen contains "reporter"
expect screen contains "In Progress"
# The tree: ENG-2 hangs off ENG-1, so collapsing the epic takes it away.
key h
expect screen lacks "ENG-2"
key l
expect screen contains "ENG-2"
# The second tab is the whole project, sub-task and all.
key 2
key r
expect screen contains "ENG-4"
expect screen contains "Wire the blur handler"
expect screen contains "Apple Pay"
# The filter is live and Esc clears it.
type /
type blur
key enter
expect screen contains "filter: blur"
expect screen contains "ENG-4"
expect screen lacks "Apple Pay"
key esc
expect screen contains "Apple Pay"
# The help sheet lists the tree keys.
type ?
expect screen contains "expand / collapse"
expect screen contains "hide the branch"
key esc
# `x` hides a branch and says how to get it back; `H` does.
key g
key x
expect screen contains "hidden"
key H
expect screen contains "ENG-1"
# Transitioning asks before it moves anything, and Esc leaves it alone.
type t
expect screen contains "move ENG-1"
expect screen contains "Send to review"
key esc
# q ends the pane.
key q
wait 500
key x
expect screen lacks "1 Mine"
# Uninstall before leaving. The corpus shares ONE data root across every
# file, so a manifest left installed here is still installed when the
# next integrations script asks how many there are — which is how this
# script took six other tests down with it the first time it ran.
command integrations.show_installed
# The four first-party rows sit above the manifests: walk down to this one.
key down
key down
key down
key down
key x
expect screen contains "Remove Jira?"
key r
expect screen contains "removed jira"
# The tab drops back to the four first-party rows, never to empty.
expect screen contains "Installed (4)"
shell kill "$(cat fake-jira.pid)" 2>/dev/null || true
