# env: HOME=home
# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# The filter pill narrows the cards by name; Esc clears the text, then
# blurs the pill. Two fake sessions carry the same title, so one is
# renamed first (the alias is the name the filter reads). (The header's
# count gives way to the chips at the sidebar's width, so the narrowing
# shows in the cards.)

write bin/claude #!/bin/bash\nsid=""\nwhile [ $# -gt 0 ]; do case "$1" in --session-id|--resume) sid=$2; shift 2;; *) shift;; esac; done\nprintf '\\033]0;\\342\\234\\263 fix the failing tests\\007'\nprintf 'Claude Code v9 (fake)\\n'\nexec -a claude /bin/sh -c 'i=0; while [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done' --resume "$sid"
shell chmod +x bin/claude
command ai.claude_code_new
wait 300
command ai.claude_code_new
wait 300
command view.activity_sessions
wait 500
expect screen contains "SESSIONS (2)"
key R
type release train
key enter
command view.activity_sessions
expect screen contains "release train"
key /
type release
expect screen contains "󰍉 release"
expect screen contains "release train"
expect screen lacks "▌ fix the failing tests"
key esc
expect screen contains "SESSIONS (2)"
expect screen contains "▌ fix the failing tests"
