# The Files pane and the tree notice a file created outside mnml: the
# watcher (src/app/watch.zig, a 2 s pass) re-reads a listing whose
# directory mtime moved. `files.refresh` / tree `r` used to be the only
# way the new entry appeared.
write a.txt "a"
command files.open
expect screen contains "(1)"
expect screen lacks "zzz-external.txt"
shell touch zzz-external.txt
wait 2200
expect screen contains "zzz-external.txt"
expect screen contains "(2)"
# The tree too: it lists the workspace root.
command view.focus_tree
shell touch yyy-external.txt
wait 2200
expect screen contains "yyy-external.txt"
