# The which-key popup as Rust paints it: the leader on the top edge —
# the ACTIVE profile's — group labels with their `+`, the keys typed so
# far in the title of a sub-popup (which since 2026-09-14 carries that
# group's own row, `<leader>f  +find (8)`), and `esc to cancel` at the
# bottom.
# Since 2026-09-24 the standard profile's popup is its own `Ctrl+K`
# chords (`whichkey_standard_ctrl_k.test`): the same box, `Ctrl+K` on
# its edge, and rows that are what `Ctrl+K <key>` runs — never the
# leader tree, whose `s` was `+split` while `Ctrl+K S` ran something else.
command whichkey.leader
expect screen contains "┌ Ctrl+K "
expect screen contains "s → save all"
expect screen contains "g → +git (1)"
expect screen lacks "f → +find"
expect screen lacks "s → +split"
expect screen contains "esc to cancel"
type g
expect screen contains "┌ Ctrl+K g "
expect screen contains "c → commit"
key esc
expect screen lacks "esc to cancel"

command editor.use_vim
command whichkey.leader
expect screen contains "┌ <leader> "
expect screen contains "f → +find"
expect screen contains "n → line numbers"
expect screen contains "q → close buffer"
expect screen contains "e → explorer"
expect screen lacks "w → write/save"
expect screen contains "P → +pr"
expect screen contains "esc to cancel"
type f
expect screen contains "┌ <leader>f  +find (8) "
expect screen contains "f → files"
expect screen contains "g → grep"
key esc
expect screen lacks "esc to cancel"
expect screen lacks "f → +find"
