# The filter row narrows every section by substring and Viewing N
# follows; Esc clears the text first, then leaves the filter.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write .gitignore ".mnml/\n"
write a.txt "one\n"
shell git add .gitignore a.txt
shell git commit -q -m "init"
shell git branch feature
shell git tag feat-1
command view.activity_git
wait 1000
expect screen contains "Viewing 4"
click 8 2
expect screen contains "type to filter"
# `feat`, not `fea`: the workspace is `mnml-e2e-<6 hex>`, and a name
# with `fea` in it (1 run in ~1000) put the WORKTREES row in the count.
type feat
expect screen contains "Viewing 2"
expect screen contains "  󰘬 feature"
expect screen contains "  󰓹 feat-1"
expect screen lacks "󰘬 main"
type ure
expect screen contains "Viewing 1"
expect screen lacks "feat-1"
key esc
expect screen contains "Viewing 4"
expect screen contains "type to filter"
key esc
expect screen contains "/ filter"
