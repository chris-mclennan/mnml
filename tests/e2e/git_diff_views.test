# The diff pane's three views (src/ui/diff_view.zig), painted as the
# Rust editor paints them: Inline is the default and shows the whole
# file as one column (a line far from the change appears, no `@@`
# header); `t` cycles Inline → Split → Hunk (`v` anchors a line
# selection, see git_diff_stage_lines.test); Split shows old and new
# side by side under a header that spans both; Hunk shows `@@` headers
# and three lines of context only. `/` narrows the pane to the hunks
# holding a string, esc clears it.
shell git init -q
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write code.rs "fn alpha() {}\nfn two() {}\nfn three() {}\nfn four() {}\nfn five() {}\nfn six() {}\nfn seven() {}\nfn eight() {}\nfn nine() {}\nfn omega() {}\n"
shell git add code.rs
shell git commit -q -m "initial"
shell printf "fn beta() {}\nfn two() {}\nfn three() {}\nfn four() {}\nfn five() {}\nfn six() {}\nfn seven() {}\nfn eight() {}\nfn nine() {}\nfn omega() {}\n" > code.rs
open code.rs
command git.diff_file
# Inline: the toolbars, the banner, the whole file, no hunk header.
expect screen contains "Hunk   Inline   Split"
expect screen contains "Hunk 1/1  code.rs"
expect screen contains "Stage   Discard"
expect screen contains "- fn alpha() {}"
expect screen contains "+ fn beta() {}"
expect screen contains "omega"
expect screen lacks "@@ -1"
key t
# Split: old on the left, new on the right, the header across both.
expect screen contains "@@ -1"
expect screen contains "- fn alpha() {}"
expect screen contains "+ fn beta() {}"
key t
# Hunk: the `@@` header with its own chips; three lines of context
# stop before `omega`.
expect screen contains "@@ -1"
expect screen contains "+1 -1"
expect screen lacks "omega"
command git.diff_toggle_view
expect screen contains "omega"
expect screen lacks "@@ -1"
# The filter: no hunk holds `zzz`, so no row shows; one esc clears it
# (and leaves the filter) and the file is back; a second esc would
# close the pane.
key /
type zzz
expect screen contains "/ zzz_"
expect screen lacks "alpha"
key esc
expect screen contains "alpha"
expect screen lacks "/ zzz"
