# `:` cmdline Tab completion — cycles through ex commands AND registered
# palette commands. 2026-06-19 — completer was unified (registry + vim
# ex names merged); first Tab now picks the highest-scoring alphabetical
# match across both sources.

write data.txt "alpha"
open data.txt
command editor.use_vim

# Open the cmdline. Type "wr" — an ex verb the text begins outranks the
# registry ids that only contain it (Neovim: getcompletion("wr",
# "cmdline") = { "write" }): `write` (350) before ai.write_branch_name /
# ai.write_tests / view.toggle_wrap (contains, 200).
key :
type "wr"
key tab
expect screen contains ":write"
key escape

# "ta": the ex verbs (tabclose, tabedit, …; 350) before the tab.* ids
# (prefix, 300), alphabetical within each (Neovim lists tabclose then
# tabedit among its own).
key :
type "ta"
key tab
expect screen contains ":tabclose"
key tab
expect screen contains ":tabedit"
key escape

# File-path completion: after a path-accepting command + space, Tab cycles
# through workspace entries. Set up a few files so we have something to
# complete.
write apple.md "a"
write apricot.md "b"

key :
type "e ap"
key tab
# First match (alphabetical): "apple.md".
expect screen contains ":e apple.md"
# Second Tab → "apricot.md".
key tab
expect screen contains ":e apricot.md"
key escape

# A single directory match: the next Tab descends into it and cycles its
# entries (vim `wildmode=full`: `:e sr<Tab>` → `src/`, Tab → `src/app.zig`).
write src/app.zig "a"
write src/main.rs "b"
key :
type "e sr"
key tab
expect screen contains ":e src/"
key tab
expect screen contains ":e src/app.zig"
key tab
expect screen contains ":e src/main.rs"
key escape
