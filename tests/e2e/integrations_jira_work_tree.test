# Jira Work (integrations/jira/, built beside the exe as $MNML_JIRA)
# installed from a Dev folder and mounted as a pane against the offline
# server beside it ($MNML_FAKE_JIRA): the caps header with the count,
# the tab strip, the mode chips, the status-grouped tree with the
# auto-expanded ticket and its PR rows, the fold keys, the hint row
# from the bindings, the second tab, and the statusline chip the pane
# publishes over the IPC channel.
#
# The workspace is an SDK checkout (it has sdk/mnml-sdk), so its
# integrations/ is a dev root by itself; the folder's manifest.zon names
# the prebuilt binary, so Install skips the build. The pane reads
# <workspace>/.mnml/integrations/jira/config.zon.
# The pane's token bucket, private to this file. Without it the
# bucket resolves to a machine-wide shared file (the fleet's
# ~/.tattle-claude-artifacts/jira-ratelimit.json), where anything
# else on the machine can drain it and leave the pane on
# `loading…` for a minute — a flake with no cause on screen.
# env: JIRA_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/jira-bucket.json
# env: JIRA_API_TOKEN=fake-token
# env: JIRA_BASE_URL=@${MNML_E2E_WORKSPACE}/jira.url
# The fake takes port 0 and writes the URL it landed on to `jira.url`;
# `JIRA_BASE_URL=@<file>` is how the pane reads it, so nothing here ever
# picks a port and two runs of the corpus never collide. The config's
# `.jira_url` is the placeholder that override replaces.
shell "$MNML_FAKE_JIRA" --port 0 --url-file jira.url --life-secs 180 --quiet --pid-file fake-jira.pid >/dev/null 2>&1 &
wait 500
write sdk/mnml-sdk/build.zig ""
write integrations/jira/build.zig ""
write integrations/jira/manifest.zon ".{ .id = \"jira_work\", .label = \"Jira Work\", .version = \"0.2.0\", .binary = \"$MNML_JIRA\", .category = \"tracker\", .commands = .{ .{ .id = \"jira_work.open\", .title = \"Jira Work\", .args = .{ \"--only\", \"work\" } } }, .statusline = .{ .{ .id = \"assigned\", .text = \"\u{f0303}\", .color = \"#1B5DCF\", .click_command = \"jira_work.open\" } } }"
write .mnml/integrations/jira/config.zon ".{ .jira_url = \"https://jira.invalid\", .email = \"fake@acme.com\", .refresh_interval_secs = 0, .rate = .{ .per_sec = 1000, .burst = 1000 }, .tabs = .{ .{ .name = \"Assigned\", .kind = .work_assigned }, .{ .name = \"Recently Done\", .kind = .work_recently_done } } }"
command integrations.show_in_dev
expect screen contains "INTEGRATIONS"
drag 30 5 60 5
expect screen contains "[dev] Jira Work  0.2.0  not installed"
key i
expect screen contains "installed jira_work from"
# The install toasts sit over the pane's last row until they expire, and
# the rows under them are only trustworthy once they are gone. The wait
# only covers the part of the 4 s toast life the expect's own 3 s poll
# budget cannot; the expect is what decides when to go on.
wait 1200
expect screen lacks "installed jira_work from"
# The pane mounts, searches the offline Jira and paints.
# The corpus lays its screens out at full width: the pane opens as a tab,
# not beside whatever the install left active (`integrations.open_as`).
command integrations.open_as_tab
command jira_work.open
# The pane is a separate process whose first search is synchronous:
# it spawns, is handed its geometry, searches, and fetches each
# unresolved ticket's linked PRs before it can paint a count. On a
# loaded machine that outlasts an expect's own 3 s budget, so the
# wait is what covers the startup and the expects below only cover
# the jitter.
wait 8000
command view.toggle_tree
command view.focus_pane
expect screen contains "JIRA WORK (3)"
# The tab says what the manifest installed, and wears the manifest's
# own chip glyph rather than one placeholder for every integration.
expect pane "Jira Work"
expect screen contains "󰌃 Jira Work"
expect screen contains "1 Assigned"
expect screen contains "2 Recently Done"
# The mode chips, never clipped.
expect screen contains " basic "
expect screen contains " assignee: All "
expect screen contains " status: All "
expect screen contains "/ filter"
# The columns and the tree: In PR Review first, ENG-2 auto-expanded
# with its two PRs and the buttons on them.
expect screen contains "KEY"
expect screen contains "SUMMARY"
expect screen contains "In PR Review (1)"
expect screen contains "ENG-2"
expect screen contains "Card form validates on blur"
expect screen contains "MERGED"
expect screen contains "Validate the card form on blur"
expect screen contains "[ Review]"
expect screen contains "[󰏌 Open]"
expect screen contains "In Progress (1)"
expect screen contains "ENG-1"
expect screen contains "To Do (1)"
expect screen contains "ENG-5"
expect screen lacks "ENG-3"
# The hint row comes from the bindings, through the toolkit: entries
# shed from the FRONT as the pane narrows, so the ones that always
# apply survive and `? keys` — the door to the rest — is last.
expect screen contains "a assignee · S select"
expect screen contains "? keys"
# The statusline chip: the manifest's slot, replaced live with the count
# the pane published over the IPC channel (the host drains it on a tick).
wait 800
expect screen contains "󰌃 3"
# j to the ticket, h folds it (the PRs go), l opens it again.
key j
key h
expect screen lacks "Validate the card form on blur"
key l
expect screen contains "Validate the card form on blur"
# The second tab: the Done group, collapsed tickets.
key 2
expect screen contains "JIRA WORK (1)"
expect screen contains "Done (1)"
expect screen contains "ENG-12"
key 1
expect screen contains "JIRA WORK (3)"
# ? opens the key sheet the built-in sections use; Esc closes it.
type ?
expect screen contains " Keys "
expect screen contains "── rows ── "
expect screen contains "fold a group · expand a ticket · open a PR"
key esc
expect screen lacks "── rows ── "
# q ends the pane.
key q
wait 500
key x
expect screen lacks "1 Assigned"
# Uninstall before leaving. The data root is this file's own, so nothing
# here reaches another file; the removals are here because the remove
# flow is worth exercising. x removes one row at a time — the last
# manifest row each time, alphabetically.
command integrations.show_installed
expect screen contains "Installed (7)"
# The three manifests sort last: End reaches each in turn.
key end
key x
expect screen contains "Remove Jira Work?"
key r
expect screen contains "removed jira_work"
command integrations.show_installed
key end
key x
expect screen contains "Remove Jira Fix Versions?"
key r
expect screen contains "removed jira_fix_versions"
command integrations.show_installed
key end
key x
expect screen contains "Remove Jira Boards?"
key r
expect screen contains "removed jira_boards"
expect screen contains "Installed (4)"
shell kill "$(cat fake-jira.pid)" 2>/dev/null || true
