# width: 120
# height: 40
# env: JIRA_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/jira-bucket.json
# env: JIRA_API_TOKEN=fake-token
# env: JIRA_BASE_URL=@${MNML_E2E_WORKSPACE}/jira.url
# The tracker pane on an event feed (`sdk.feed.FileFeed`): while the
# file is live the tab is not polled, and a line naming a ticket costs
# one search — `key in (…)` inside the tab's own query — however many
# lines name it. A teammate closes ENG-1; the feed says so; the one
# search's answer does not hold it, so it drops off the tab.
shell "$MNML_FAKE_JIRA" --port 0 --url-file jira.url --life-secs 180 --quiet --log-file jira.log --pid-file fake-jira.pid >/dev/null 2>&1 &
wait 500
write sdk/mnml-sdk/build.zig ""
write integrations/jira/build.zig ""
write integrations/jira/manifest.zon ".{ .id = \"jira_work\", .label = \"Jira Work\", .version = \"0.2.0\", .binary = \"$MNML_JIRA\", .category = \"tracker\", .commands = .{ .{ .id = \"jira_work.open\", .title = \"Jira Work\", .args = .{ \"--only\", \"work\" } } } }"
# The feed file sits beside the config, which is where a relative
# `feed.file` is read from; a heartbeat makes it live from the start.
write .mnml/integrations/jira/feed.jsonl "{\"kind\":\"heartbeat\",\"at\":1,\"source\":\"e2e\"}\n"
write .mnml/integrations/jira/config.zon ".{ .jira_url = \"https://jira.invalid\", .email = \"fake@acme.com\", .refresh_interval_secs = 1, .poll_max_secs = 1, .feed = .{ .file = \"feed.jsonl\", .stale_secs = 120, .sweep_secs = 600 }, .rate = .{ .per_sec = 1000, .burst = 1000 }, .tabs = .{ .{ .name = \"My open work items\", .kind = .work_open } } }"
command integrations.show_in_dev
expect screen contains "INTEGRATIONS"
drag 30 5 60 5
key i
expect within 10000 screen contains "installed jira_work from"
expect within 10000 screen lacks "installed jira_work from"
command integrations.open_as_tab
command view.toggle_tree
command jira_work.open
expect within 30000 screen contains "JIRA WORK (3)"
expect within 30000 file jira.log contains "issueId=10005"
command view.focus_pane
expect within 5000 screen contains "· feed"
expect screen contains "Checkout rewrite"

# Four seconds with a one-second poller configured: no search, because
# the feed is live.
shell : > jira.log
wait 4000
expect file jira.log lacks "search/jql"

# The teammate's close, straight at the fake (fixture credential), and
# the relay's word on it — twice, with a pull-request line between.
shell curl -s -o /dev/null -u fake@acme.com:fake-token -H 'Content-Type: application/json' -d '{"transition":{"id":"41"}}' "$(cat jira.url)/rest/api/3/issue/ENG-1/transitions"
shell : > jira.log
shell printf '%s\n' '{"kind":"issue","key":"ENG-1","at":1790000000,"source":"e2e"}' '{"kind":"pr","key":"api#1","at":1790000001}' '{"kind":"issue","key":"ENG-1","at":1790000002,"source":"e2e"}' >> .mnml/integrations/jira/feed.jsonl
expect within 10000 screen contains "JIRA WORK (2)"
expect screen lacks "Checkout rewrite"
wait 1500
# One request: the search for that ticket, inside the tab's query.
shell n=$(grep -c . jira.log); s=$(grep 'key in (' jira.log | grep -c 'ENG-1'); echo "requests=$n feed-searches=$s"; test "$n" -eq 1 && test "$s" -eq 1
expect screen contains "updated from the event feed"
shell kill "$(cat fake-jira.pid)" 2>/dev/null || true
