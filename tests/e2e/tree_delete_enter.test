# The tree's delete confirm (the reference editor's): Cancel is the
# focused button, so Enter does not delete — but it is no longer a
# SILENT way out. It says the file was kept and names the key that
# deletes. `d` trashes and toasts; Esc is the one quiet exit.
write a.txt "aa"
command view.focus_tree
key r
key end
command file.delete
expect screen contains "Delete a.txt?"
expect screen contains "Delete [P]ermanently"
key enter
expect screen lacks "a.txt?"
expect screen contains "cancelled — a.txt kept"
expect file a.txt contains "aa"
command file.delete
key d
expect screen contains "deleted a.txt"
expect screen lacks "a.txt?"
