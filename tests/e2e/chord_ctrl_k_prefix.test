# width: 120
# A bare `ctrl+k` is `whichkey.leader` in the standard profile AND the
# prefix of eighteen `ctrl+k …` chords (view.fullscreen, lsp.hover,
# git.commit, the four focus-split chords and eleven more). Chord
# resolution wins: the tail key completes the chord, and only a pause
# past `timeoutlen` lets the leader fallback open the popup.
#
# It did not. The driver expired every pending chain the moment it was
# asked, so the popup opened on the `ctrl+k` itself and ate the tail —
# not one of the eighteen could be driven, including the `Ctrl+K Ctrl+I`
# the Info panel advertises for hover. `App.tick` always read the
# deadline; `app/driver.zig`'s hook now reads the same clock.
write a.txt "alpha\n"
open a.txt
expect screen contains "EDIT"

# `Ctrl+K Z` reaches view.fullscreen, not the leader popup.
key ctrl+k
key z
expect screen lacks "no leader mapping"
expect screen lacks "f → +find"
expect screen lacks "EDIT"
expect screen contains "Full screen"
key esc
key esc
expect screen contains "EDIT"

# `Ctrl+K T` is the theme toggle — a second chord, same rule.
key ctrl+k
key t
expect screen lacks "no leader mapping"
expect screen contains "theme: "

# A lone `ctrl+k` and a pause past the 500 ms timeout opens the popup of
# the profile's own `Ctrl+K` chords (`standard_ctrl_k_pause_menu.test`),
# never the vim leader tree; Esc cancels the chord.
key ctrl+k
wait 700
expect screen contains "┌ Ctrl+K "
expect screen contains "z → "
expect screen lacks "f → +find"
key esc
expect screen lacks "┌ Ctrl+K "

# An armed leader still owns its whole chord at speed: an unbound tail
# is dropped with a word, never handed on to the editor. (This used to
# fall out of the popup being open by the time the tail arrived.)
key ctrl+k
key q
expect screen contains "no Ctrl+K chord: Ctrl+K q"
expect dirty false
expect screen contains "Ln 1/1 Col 1"
