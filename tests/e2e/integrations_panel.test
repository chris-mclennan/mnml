# The INTEGRATIONS section (src/app/integrations.zig): a manifest under
# <workspace>/.mnml/integrations/ becomes a dyn command with its key,
# the Installed tab lists it in the Rust row shape (glyph + label, the
# first command's id under it), the detail pane shows the manifest,
# and the settings overlay grows a row for what `settings[]` declares.
write .mnml/integrations/hello.zon ".{ .id = \"hello\", .label = \"Hello Sample\", .description = \"The sample\", .version = \"0.1.0\", .binary = \"/definitely/not/here/mnml-hello\", .category = \"sample\", .chip = .{ .glyph = \"H\", .fallback = \"H\", .color = \"cyan\" }, .commands = .{ .{ .id = \"hello.open\", .title = \"Hello: open\", .keys = .{ \"ctrl+k h\" } } }, .settings = .{ .{ .key = \"greeting\", .label = \"Greeting\", .options = .{ \"HELLO\", \"HOWDY\" }, .default = \"HELLO\" } } }\n"
command integrations.refresh
expect screen contains "1 installed"
command integrations.show_installed
expect screen contains INTEGRATIONS
# Four first-party rows (integrations_first_party_rows.test) plus this one.
expect screen contains "Inst (5)"
# The column is 26 cells at the shipped width: the row clips; a drag on
# the divider widens it and the whole row reads. The manifest sits under
# the first-party block, so the cursor walks down to it.
drag 30 5 60 5
key down
key down
key down
key down
expect screen contains "H Hello Sample (mnml-hello not installed)"
expect screen contains "hello.open"
# The detail pane: the buttons, the command with its chord, the missing binary.
key d
expect screen contains "[ Open ]  [ Disable ]  [ Edit manifest ]"
expect screen contains "hello.open  Hello: open  ctrl+k h"
expect screen contains "binary missing"
key esc
# The manifest's setting is a row of the settings overlay.
command view.settings
key end
expect screen contains "Hello Sample: Greeting"
expect screen contains "[HELLO] / HOWDY"
key esc
# A manifest command with a missing binary fails with a reason, not a pane.
command hello.open
expect screen contains "cannot run"
