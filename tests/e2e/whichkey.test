# `whichkey.leader` opens the leader menu; a group key descends into it;
# Esc closes it.
# (The leader tree is the vim profile's popup. The standard profile's
# which-key popup — `whichkey.leader` and the Ctrl+K pause alike — is its
# own `Ctrl+K` chords since 2026-09-24: `whichkey_standard_ctrl_k.test`.)
write src.txt hello world
open src.txt
command editor.use_vim
expect screen lacks "+split"

command whichkey.leader
expect screen contains "+split"

# Descend into the +split group — its leaves show up.
key s
expect screen contains "split right"
expect screen contains "split down"

key esc
expect screen lacks "split right"
