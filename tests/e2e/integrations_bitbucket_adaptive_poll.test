# width: 120
# height: 40
# The forge pane's poller backs off while nothing changes, and a key
# brings it straight back (`sdk.feed.Schedule`).
#
# The base interval is one second and the cap eight. The fake answers
# every conditional GET after the first load with a 304 — the listing
# never moves — so the polls come at 1, 2, 4, 8 seconds apart instead of
# one a second: the wire's own count over twelve seconds is the proof,
# not anything the pane says about itself. Then, right after a poll at
# the eight-second pace, a key: the next poll comes about a second later
# rather than eight.
# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --life-secs 180 --log-file wire.jsonl >/dev/null 2>&1 &
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .account_id = \"acct-chris\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 1, .poll_max_secs = 8, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket: open + merged pull requests across the workspace\", .chip = .{ .glyph = \"\u{f00a8}\", .fallback = \"BP\", .color = \"blue\", .in_palette_bar = false }, .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket_prs"
command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
expect within 30000 screen contains "(2 repos · 3 PRs)"

# Twelve seconds of a listing that never moves. At the base pace that
# is a dozen polls; backing off (1, 2, 4, 8) it is four at most.
shell : > wire.jsonl
wait 12000
shell n=$(grep -c '"path":"/2.0/repositories/acme/api/pullrequests"' wire.jsonl); echo "polls in 12s: $n"; test "$n" -ge 1 && test "$n" -le 5
# Every one of them was answered 304: nothing moved.
expect file wire.jsonl contains "\"status\":304"
expect file wire.jsonl lacks "\"status\":200"
# The chip says the pace it has backed off to.
expect within 10000 screen contains "· 8s"

# A key, right after a poll at the slow pace: back to the base.
shell : > wire.jsonl
expect within 12000 file wire.jsonl contains "acme/web/pullrequests\""
wait 300
shell : > wire.jsonl
# (The listing's own path: a key that moves the cursor may also ask
# about the row it lands on, under `pullrequests/<id>/…`.)
key j
expect within 2500 file wire.jsonl contains "acme/api/pullrequests\""
expect within 3000 screen contains "· 1s"

key q
wait 500
