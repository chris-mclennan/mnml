# env: TERM_PROGRAM=Hyper
# env: SHELL=/bin/sh
# Right-click the strip's terminal chip: the shell rows, then
# `Terminal icon` with the three values of `ui.terminal_glyph` under
# it and the current one ticked. Picking Terminal swaps the chip's
# mark from mnml's own ghost to the codicon — `$TERM_PROGRAM` is one
# no table knows here, so the codicon is where the per-emulator
# choice lands.
#
# The chip is the first of the split cluster, three cells apart, at
# the right end of row 1 on the 120-column screen. `Terminal icon` is
# the menu's last row, so `End` reaches it however many rows precede.
command view.toggle_tree
expect screen contains "󲀀  "
rightclick 111 1
expect screen contains "Open shell (beside)"
expect screen contains "Terminal icon"
key end
key right
expect screen contains "Ghostty"
expect screen contains "Custom SVG…"
expect screen contains "✓ Ghostty"
expect screen lacks "✓ Terminal"
# Enter on the child's first row — Terminal.
key enter
expect screen contains "terminal icon: the codicon terminal"
expect screen contains "  "
expect screen lacks "󲀀  "
# The tick moved, and the menu says so.
rightclick 111 1
key end
key right
expect screen contains "✓ Terminal"
expect screen lacks "✓ Ghostty"
key esc
expect screen lacks "Open shell (beside)"
