# env: TERM_PROGRAM=Hyper
# env: SHELL=/bin/sh
# Right-click the strip's terminal chip: the shell rows, then `Icon`
# with the two branded choices under it and the current one ticked
# (the bake sits below them, separated). Picking Terminal swaps the
# chip's mark from mnml's own ghost to the codicon — `$TERM_PROGRAM`
# is one no table knows here, so the codicon is where the
# per-emulator choice lands.
#
# The chip is the first of the split cluster, three cells apart, at
# the right end of row 1 on the 120-column screen. `Icon` is the
# menu's last row, so `End` reaches it however many rows precede.
#
# Each row draws the icon it picks: the ghost on one, the codicon on
# the other. They both used to draw a paint brush.
command view.toggle_tree
expect screen contains "󲀀  "
rightclick 111 1
expect screen contains "Open shell (beside)"
expect screen contains "Icon"
key end
key right
expect screen contains "Ghostty"
expect screen contains "Custom SVG…"
expect screen contains "✓ Ghostty"
expect screen lacks "✓ Terminal"
expect screen contains "󲀀  ✓ Ghostty"
expect screen contains "  Terminal"
# Down then Enter — the second row, Terminal.
key down
key enter
expect screen contains "terminal icon: the codicon terminal"
expect screen contains "  "
expect screen lacks "󲀀  "
# The tick moved, and the menu says so.
rightclick 111 1
key end
key right
expect screen contains "✓ Terminal"
expect screen lacks "✓ Ghostty"
key esc
expect screen lacks "Open shell (beside)"
# A pty tab wears the mark the menu chose, not the ghost it shipped
# with — the same resolver the chip reads (`app/terminal_glyph.zig`).
command view.toggle_tree
command term.shell
wait 300
expect screen contains " terminal (sh) 󰅖"
expect screen lacks "󲀀 terminal (sh) 󰅖"
