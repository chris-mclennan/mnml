# requires: macos
# `session.restore_terminals = .dormant` is the other way to restore a
# terminal pane: the tab, the title and `[exited] — any key restarts
# <label>`, starting nothing until a key asks. The default is
# `.running` (tests/e2e/session_restore_terminal_running.test); this
# file drives the Settings row that switches it, because the switch is
# only real if it is reachable.
write notes.txt "alpha\n"
open notes.txt

# Integrations → Restore terminals, found by search rather than by a
# row number that moves. Enter hands the list back to the cursor, `→`
# cycles the value, Enter saves and closes.
command view.settings_search
type "restore terminals"
expect screen contains "Restore terminals:"
expect screen contains "[running] / dormant"
key enter
key right
expect screen contains "running / [dormant]"
key enter
expect screen lacks "Restore terminals:"

command editor.use_vim
command term.shell_bottom
wait 2000
expect screen contains "TERMINAL"
expect screen lacks "any key restarts"

# The pane IS saved — losing the tab would be its own bug.
command session.save
expect file .mnml/session.zon contains "pty"

command session.restore
wait 500
expect screen contains "session restored"
expect screen contains "[exited] — any key restarts"

# And a key on it starts the child the restore did not.
key enter
wait 1500
expect screen lacks "any key restarts"
