# Lua (D10): the shipped example `lua/recent-commands/init.lua`,
# run as it is written — the file is copied into the workspace's
# init.lua, so a change to the example that breaks it fails here.
shell mkdir -p .mnml && cp "${MNML_REPO:?}/lua/recent-commands/init.lua" .mnml/init.lua
command script.reload
expect screen contains "scripts: reloaded"
command user.recent
expect screen contains "Recent commands"
# The MRU is the app's own, so `script.reload` — which this file just
# ran — heads the list with its `*`, and the preview column names it.
expect screen contains "* Lua: reload init.lua"
expect screen contains "run 1 ago"
# Typing asks the live source again; the rows and the preview follow.
type "quit mnml"
wait 300
expect screen contains "Quit mnml"
expect screen contains "app.quit"
expect screen lacks "* Lua: reload init.lua"
key esc
# An accepted row goes to the front of the app's MRU, so it is marked
# with its `*` the next time the picker opens. The MRU is the app's,
# and the app only records a command that SUCCEEDED — so there is a
# file open for `file.save` to write.
write notes.txt "hello"
open notes.txt
command user.recent
type "save file"
wait 300
key enter
command user.recent
expect screen contains "* Save file"
key esc
