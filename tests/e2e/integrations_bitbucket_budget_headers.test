# width: 120
# height: 40
# The Bitbucket pane's API budget chip reads the numbers the API sends,
# and every call it makes lands on the day's tally under the data root.
#
# The fake's budget dial sends `X-RateLimit-Limit: 1000` and a
# `-Remaining` that starts at 900 and drops one per request, so the
# chip's figure is the fake's, whatever the load cost; the tally is
# compared with the wire's own count of what arrived.
# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --life-secs 180 --log-file wire.jsonl --rate-limit-limit 1000 --rate-limit-remaining 900 >/dev/null 2>&1 &
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket: open + merged pull requests across the workspace\", .chip = .{ .glyph = \"\u{f00a8}\", .fallback = \"BP\", .color = \"blue\", .in_palette_bar = false }, .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket_prs"
command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
expect within 30000 screen contains "(2 repos · 3 PRs)"
# The chip carries the fake's numbers: some of the 900 spent, of 1000.
expect within 10000 screen contains "/1000 "
expect screen lacks "900/1000"
# Every call on the wire is one on today's tally — and nothing else is.
wait 1500
shell n=$(grep -c . wire.jsonl); t=$(head -1 "$MNML_DATA_ROOT/budget/bitbucket.tally" | cut -d' ' -f2); echo "wire=$n tally=$t"; test "$n" -gt 0 && test "$n" -eq "$t"
# A refresh spends more, and the tally follows the wire again.
shell grep -c . wire.jsonl > before.txt
key r
expect within 20000 file wire.jsonl contains "\"status\":304"
wait 1500
shell n=$(grep -c . wire.jsonl); b=$(cat before.txt); t=$(head -1 "$MNML_DATA_ROOT/budget/bitbucket.tally" | cut -d' ' -f2); echo "wire=$n before=$b tally=$t"; test "$n" -gt "$b" && test "$n" -eq "$t"
key q
wait 500
