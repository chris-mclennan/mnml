# The sample integration (integrations/sample/, built beside the exe as
# $MNML_SAMPLE_INTEGRATION) installed from a Dev folder: the workspace
# is an SDK checkout (it has sdk/mnml-sdk), so its integrations/ is a
# dev root by itself; the folder's manifest.zon names the prebuilt
# binary, so Install skips the build and runs `<binary> --install` in a
# task pane; the manifest lands in the data root with its chip, its
# commands, its statusline segment; the pane mounts and counts;
# uninstall removes all of it. Nothing is built.
write sdk/mnml-sdk/build.zig ""
write integrations/sample/build.zig ""
write integrations/sample/manifest.zon ".{ .id = \"sample\", .label = \"Sample\", .binary = \"$MNML_SAMPLE_INTEGRATION\", .description = \"The sample\" }"
command integrations.show_in_dev
expect screen contains "INTEGRATIONS"
drag 30 5 60 5
expect screen contains "[dev] Sample  not installed  (integrations)"
expect screen contains "integrations/sample"
# i installs: the task pane runs --install, the link lands, the scan follows.
key i
expect screen contains "installed sample from"
expect screen contains "integrations/sample"
expect screen contains "[dev] Sample  installed from here  (integrations)"
# The Installed tab lists it with its version and first command.
command integrations.show_installed
expect screen contains "Sample  0.1.0"
expect screen contains "sample.open"
# The manifest's statusline segment is on the statusline.
expect screen contains "S·sample"
# The ex-backed command toasts.
command sample.hello
expect screen contains "Hello from the sample integration"
# The pane mounts over the socket and paints its counter; a key counts
# once the keys are in the pane (the section held them).
command sample.open
command view.focus_pane
expect screen contains "SAMPLE · theme"
expect screen contains "counter: 0"
key space
expect screen contains "counter: 1"
# q says bye; the banner sits under the install toast for a moment, so
# the next key closes the pane and the screen proves it went.
key q
wait 500
key x
expect screen lacks "SAMPLE ·"
# Uninstall from the Installed tab: the confirm, then everything goes.
# The four first-party rows sit above the manifest, so walk down to it.
command integrations.show_installed
key down
key down
key down
key down
key x
expect screen contains "Remove Sample?"
key r
expect screen contains "removed sample"
expect screen lacks "S·sample"
# The tab drops back to the four first-party rows, never to empty.
expect screen contains "Installed (4)"
