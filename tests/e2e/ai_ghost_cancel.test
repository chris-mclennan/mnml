# env: PATH=${MNML_SHIMS}/ghost:${PATH}
# env: MNML_FAKE_CLAUDE_DELAY_MS=8000
# Typing through a request cancels it. The `claude -p` child is killed,
# not merely ignored: leaving it to finish means a machine grinding on
# answers for cursors that moved three keystrokes ago.
write a.txt "fn main() {"
open a.txt
command ai.setup_suggestions
key enter
expect screen lacks "pick a backend"

type "\n    let x"
wait 400
expect status contains "\"ghost\":\"inflight\""

# One more keystroke ends the flight at once — no waiting out the 8 s.
type "y"
expect status lacks "\"ghost\":\"inflight\""
command messages.show
expect screen contains "cancelled (typed)"
