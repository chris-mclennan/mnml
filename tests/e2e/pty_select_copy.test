# Text comes out of a terminal pane with the mouse, as it does in every
# terminal: a drag selects the cells it crosses and the release copies
# them — to the register a `p` in an editor pastes and to the system
# clipboard (toast "copied the selection"). Double-click selects a word
# or a path, triple-click the line, Shift selects in a program that
# takes the mouse; the pane's right-click menu has Copy too.
#
# Drag across the line, then paste into an editor below.
write a.txt "\n"
command view.toggle_tree
ex term printf 'COPYME-alpha-beta\n'; sleep 30
wait 1200
expect screen contains "COPYME-alpha-beta"
drag 1 2 18 2
wait 200
expect screen contains "copied the selection"
open a.txt
command editor.use_vim
type "p"
expect screen contains "COPYME-alpha-beta"
