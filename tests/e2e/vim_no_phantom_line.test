# A file ending in `\n` has as many lines as the editor counts: no
# numbered empty line N+1 in the gutter. `G` lands on the last real line.
write a.txt "alpha\nbravo\ncharlie\n"
open a.txt
command editor.use_vim

expect screen contains "▌  3 charlie"
expect screen lacks "   4 "
key G
expect screen contains "Ln 3/3"
