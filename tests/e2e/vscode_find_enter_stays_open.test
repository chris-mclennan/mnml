# VS Code's find widget: Enter = next match, Shift+Enter = previous, Esc
# closes. The bar staying open is what keeps Shift+Enter out of the buffer.
write alpha.zig "pub fn alpha() u32 {\n    return 1;\n    return 2;\n}\n"
open alpha.zig
key ctrl+f
type return
key enter
expect screen contains " Find "
expect screen contains "match 1/2"
key enter
expect screen contains "match 2/2"
key shift+enter
expect screen contains "match 1/2"
expect dirty false
key esc
expect screen lacks " Find "
expect screen contains "Ln 2/"
