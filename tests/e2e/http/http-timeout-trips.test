# `# @timeout` trips on a server that sends its head and never finishes
# the body: the Response block reads the timeout instead of hanging.

# `serve 0`: the runner binds a free port before the file starts and
# `${SERVE_PORT}` names it — a fixed port collided when two runs of the
# corpus shared a machine.
serve 0 200 delay=2000 "late"
write slow.http "# @timeout 400ms\nGET http://127.0.0.1:${SERVE_PORT}/slow\n"
open slow.http

command http.send
wait 1200
expect screen contains "timeout: no response within 400 ms"
