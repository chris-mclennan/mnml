# width: 200
# height: 45
# An env value that names another key (BASE=http://{{HOST}}) expands
# all the way down: the header goes out with HOST's value, never the
# inner `{{HOST}}` as written.
serve 19602 200 @echo
write .mnml/env/dev.env "HOST=127.0.0.1:19602\nBASE=http://{{HOST}}\n"
write a.http "GET http://127.0.0.1:19602/echo\nX-Base: {{BASE}}/v1\n"
open a.http
command http.send
wait 1000
expect screen contains "X-Base:"
expect screen lacks "http://{{HOST}}/v1"
expect screen contains "X-Base: http://127.0.0.1:19602/v1"
