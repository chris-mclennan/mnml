# The statusline's `› name` chip took the LAST symbol whose start
# preceded the caret, whatever its kind and wherever it ended: inside a
# function that declares a local, the chip named the local; after the
# last function's closing brace it still named something (hunt finding
# sh-lsp-breadcrumb-wrong). It is the INNERMOST container — function,
# method, class, module, … — whose range holds the caret's line now,
# and nothing outside every one. `--symbols rich` has the fake report
# a function's range through its closing `}` and every `let` as a
# variable, the shape bash-language-server sends.
write src/main.fk "fn foo() {\n  let x = 1;\n  let y = 2;\n  foo(x);\n}\nfn bar() { foo(); }\n\n// trailing words\n"
write Cargo.toml ""
write .mnml/config.zon .{ .lsp = .{ .fake = .{ .cmd = "$MNML_FAKE_LSP", .args = .{ "--log", "lsp.log", "--symbols", "rich" }, .extensions = .{ "fk" }, .root_markers = .{ "Cargo.toml" } } } }
open src/main.fk
expect screen contains "LSP 1"
expect screen contains "› foo"
# Line 4, inside foo, below both locals.
key down
key down
key down
expect screen contains "› foo"
expect screen lacks "› y"
# Line 6, the one-line bar.
key down
key down
expect screen contains "› bar"
# Line 8, outside every function: no crumb.
key down
key down
expect screen lacks "› bar"
expect screen lacks "› y"
