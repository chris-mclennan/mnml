# width: 120
# height: 40
# The launcher dock on the LEFT edge, and the side columns in `auto`.
# Both want the screen's left edge: the dock paints its items down
# columns 0..2, and the hidden sidebar paints its edge grip over the
# same rows (`src/ui/edge_grip.zig` fills its own ground). The grip is
# painted after the dock, so it ERASES two of the dock's three items —
# the Browser icon goes blank and the New-terminal icon is replaced by
# the grip's `⋮`, on a cell whose hit still belongs to the dock item.
write a.txt "alpha\n"
open a.txt
command view.toggle_hover_help
ex dock always
ex dock left
# All three items are on the strip: `+`, Browser, New terminal.
expect screen contains "\n 󰐕 "
expect screen contains "\n  "
expect screen contains "\n 󲀀 "
command view.sidebar_mode_auto
# Move the pointer off the edge so the column hides.
hover 60 10
wait 800
expect screen lacks "Add workspace"
# The dock is still `always` — its items must all still be there,
# each on its own row of the strip.
expect screen contains "\n 󰐕 "
expect screen contains "\n  "
expect screen contains "\n 󲀀 "
