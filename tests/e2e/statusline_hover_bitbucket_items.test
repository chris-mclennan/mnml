# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# The PR chip's hover lists the pull requests it counts, by name, with
# the repo each lives in. `--values` publishes both the figure and the
# rows behind it on the workspace's own Tier-2 channel, which the
# runner drains like any other line.
#
# The assertion that keeps it honest is the one on the wire: the rows
# come out of the listing the counts already came from, so a run that
# carries them asks for exactly what a run without them asked for.
shell mkdir -p .mnml/ipc-zig
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --lifetime-secs 180 --log-file wire.jsonl >/dev/null 2>&1 &
wait 500
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket pull requests\", .commands = .{ .{ .id = \"bitbucket_prs.open_mine\", .title = \"Bitbucket PRs: open (mine only)\", .args = .{ \"--only\", \"prs-mine\" } } } }"
command integrations.show_marketplace
key i
expect screen contains "installed bitbucket_prs"
command integrations.open_as_tab
shell "$MNML_BITBUCKET_INTEGRATION" --values --workspace "$MNML_E2E_WORKSPACE" > values.json
wait 700
expect screen contains "2(1)"
command view.toggle_hover_tooltip
# The PR chip on the statusline (row 38): the one chip the
# values run publishes, at the left of the right lane.
hover 66 38
wait 300
expect screen contains "2 open pull requests of yours (1 still unapproved)"
expect screen contains "waiting on your review"
expect screen contains "Fix the login redirect"
expect screen contains "acme/api"

# The wire: whoami, one listing per repo, one comments pass per pull
# request of mine that moved. Five, and five is what the same run asked
# for before `items` existed — measured against the pre-branch binary,
# same paths in the same order. A hover that costs a request is not
# worth having, and this line is what says so. The two more are each
# repo's pipelines for the bare-number links' range table, asked for on
# a first run and then once an hour — not by the hover.
shell test "$(wc -l < wire.jsonl | tr -d ' ')" -eq 7
shell test "$(grep -c '/pipelines/' wire.jsonl)" -eq 2

# A row is a click target, and a press on it runs what the row names
# — here the mine-only tab. The box sits above the chip; its first
# row is line 34.
click 70 34
wait 2500
expect screen contains "BITBUCKET"
