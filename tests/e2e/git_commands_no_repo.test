# Git commands from a non-git workspace should toast gracefully,
# not panic or show an error without context.
#
# The full toasts read `merge: detached HEAD — checkout a branch first`
# / `rebase: detached HEAD — checkout a branch first`, but the toast
# renderer clips at the box border around "firs" on a 120-col screen.
# We only assert the still-visible prefix so the test doesn't depend
# on toast-box width.

command git.recent_branches
wait 50
expect screen contains "no branches (not a git repo?)"

key esc

command git.merge
wait 50
expect screen contains "detached HEAD"

key esc

command git.rebase
wait 50
expect screen contains "detached HEAD"
