# requires: macos
# env: HOME=home
# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# A Claude Code session the user never typed into has no transcript:
# Claude writes `~/.claude/projects/<cwd>/<id>.jsonl` with the first
# message, not at launch. `claude --resume` of such an id is a hard
# error — `No conversation found with session ID: <id>`, exit 1 — so
# the restore must not resume it: it starts the session again under the
# SAME id (`--session-id <id>`, `pty_pane.relaunchOf`), and the card and
# the tab keep their identity. A restart of the pane takes the same
# rule. The fake `claude` behaves as the real one does about its
# transcript and never writes one (nothing is ever typed); its first run
# ends after two seconds, so the restore meets a session that is not
# live, and every later run stays up.
write bin/claude #!/bin/bash\nsid=""\nmode="bare"\nwhile [ $# -gt 0 ]; do case "$1" in --session-id) sid=$2; mode=new; shift 2;; --resume) sid=$2; mode=resume; shift 2;; *) shift;; esac; done\nd="$HOME/.claude/projects/$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')"\nprintf '%s %s\\n' "$mode" "$sid" >> argv.log\nif [ "$mode" = resume ] && [ ! -f "$d/$sid.jsonl" ]; then printf 'No conversation found with session ID: %s\\n' "$sid"; exit 1; fi\nif [ "$mode" = new ] && [ -f "$d/$sid.jsonl" ]; then printf 'Error: Session ID %s is already in use.\\n' "$sid"; exit 1; fi\nprintf 'Claude Code (fake)\\n'\nn=60; if [ ! -f first-done ]; then n=2; : > first-done; fi\nexec -a claude /bin/sh -c 'i=0; while [ $i -lt $0 ]; do sleep 1; i=$((i+1)); done' "$n"
shell chmod +x bin/claude
write notes.txt "alpha\n"
open notes.txt

command ai.claude_code_new
wait 1500
expect screen contains "Claude Code (fake)"
expect file argv.log contains "new "

command session.save
wait 3000
expect screen contains "[exited"
shell test ! -e home/.claude/projects

command session.restore
wait 2000
expect screen contains "session restored"
# Started again, under the one id it had — never resumed.
expect file argv.log lacks "resume "
shell test "$(grep -c '^new ' argv.log)" -eq 2 && test "$(sort -u argv.log | wc -l | tr -d ' ')" -eq 1
# So the pane is live: no dead `[exited 1]`, no CLI error on it.
expect screen lacks "No conversation found"
expect screen lacks "[exited"
expect screen lacks "any key restarts"

# A restart of the pane is the same rule: still no transcript, still
# `--session-id`.
command term.restart
wait 1500
expect file argv.log lacks "resume "
shell test "$(grep -c '^new ' argv.log)" -eq 3 && test "$(sort -u argv.log | wc -l | tr -d ' ')" -eq 1
expect screen lacks "[exited"
