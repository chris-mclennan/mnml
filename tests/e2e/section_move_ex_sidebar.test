# `:sidebar right` / `:sidebar left` move the focused section (else the
# rail's mark) — the ex spelling of `Ctrl-W L` / `H`.
write treemarker.txt "a file the tree lists\n"
write src/a.zig "// TODO: alpha marker\n"
open src/a.zig
command view.activity_todos
command todos.refresh
expect screen lacks "treemarker.txt"
ex sidebar right
# A moved section gets no strip: TODOS on the right shows the tree's
# file and the TODOS rows together.
expect screen contains "TODOS"
expect screen contains "treemarker.txt"
ex sidebar left
expect screen lacks "treemarker.txt"
expect screen contains "alpha marker"
ex sidebar up
expect screen contains ":sidebar left|right"
