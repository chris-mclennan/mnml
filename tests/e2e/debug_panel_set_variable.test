# DEBUG section — a value is edited in place: Enter on the x row opens
# dap.set_variable's prompt seeded with its value; 42 lands in the row,
# and the program continues with it (line 4 makes it 43, f makes it 430).
write prog.dbg "let x = 1\nlet p = struct{a=1,b=\"two\"}\nprint \"hello\"\nx = x + 1\nfn f\n  let y = 10\n  x = x * y\nend\ncall f\nprint x\n"
write .mnml/config.zon .{ .dap = .{ .dbg = .{ .cmd = "$MNML_FAKE_DAP" } } }
open prog.dbg
command editor.use_vim
type 3j
command dap.toggle_breakpoint
command dap.run
expect screen contains "dap: stopped (breakpoint)"
expect screen contains "▶"
command view.activity_debug
expect screen contains "x: int = 1"
# status · VARIABLES · Locals · x
key j
key j
key j
key enter
expect screen contains "Set x ="
key ctrl+u
type "42"
key enter
expect screen contains "set = 42"
expect screen contains "x: int = 42"
command dap.continue
expect screen contains "dap: exited (code 0)"
command dap.show
expect screen contains "430"
