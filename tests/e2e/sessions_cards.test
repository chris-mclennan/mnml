# env: HOME=home
# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# SESSIONS lists THIS app's Claude panes as Rust's cards (src/sessions.zig):
# the name is the child's window title with its spinner stripped, then
# three rows that follow the pane — a fresh session reads its banner
# off the grid; once the scan lists the transcript the fake wrote under
# the pane's --session-id, the card at rest reads the exchange as
# `you: …` / `claude: …`, clipped to the card with an ellipsis. The
# scan's other sessions of this workspace are not cards: a live one no
# pane owns is an EXTERNAL row (branch, short id), an ended one past
# the grace window hides behind the history chip, which counts it.
# A fake `claude` on PATH stands in for the CLI (HOME is relative, so
# it is under this workspace).

write bin/claude #!/bin/bash\nsid=""\nwhile [ $# -gt 0 ]; do case "$1" in --session-id|--resume) sid=$2; shift 2;; *) shift;; esac; done\nENC=$(printf '%s' "$PWD" | sed 's/[\/.]/-/g')\nmkdir -p "$HOME/.claude/projects/$ENC"\nprintf '{"type":"user","cwd":"%s","gitBranch":"main","message":{"role":"user","content":"fix the failing tests"}}\\n{"type":"assistant","cwd":"%s","message":{"role":"assistant","content":[{"type":"text","text":"Running the suite first."}]}}\\n' "$PWD" "$PWD" > "$HOME/.claude/projects/$ENC/$sid.jsonl"\nprintf '\\033]0;\\342\\234\\263 fix the failing tests\\007'\nprintf 'Claude Code v9 (fake)\\nOpus 5 (fake)\\n'\nexec -a claude /bin/sh -c 'i=0; while [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done' --resume "$sid"
shell chmod +x bin/claude
command ai.claude_code_new
wait 500
command view.activity_sessions
wait 300
expect screen contains "SESSIONS (1)"
expect screen contains "+ New session"
expect screen contains "▌ fix the failing tests"
expect screen contains "Claude Code v9 (fake)"
expect screen contains "Opus 5 (fake)"
# The scan lists the transcript the fake wrote: at rest, the exchange.
command sessions.refresh
wait 1500
expect screen contains "you: fix the failin…"
expect screen contains "claude: Running the…"
# A live session no pane here owns, rooted in this workspace: EXTERNAL.
write fake-ext.sh #!/bin/bash\nexec -a claude /bin/sh -c 'i=0; while [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done' --resume e2e00000-0000-4000-8000-000000000002
shell chmod +x fake-ext.sh && ENC=$(printf '%s' "$MNML_E2E_WORKSPACE" | sed 's/[\/.]/-/g') && mkdir -p "home/.claude/projects/$ENC" && printf '{"type":"user","cwd":"%s","gitBranch":"main","message":{"role":"user","content":"elsewhere"}}\n' "$MNML_E2E_WORKSPACE" > "home/.claude/projects/$ENC/e2e00000-0000-4000-8000-000000000002.jsonl" && (nohup ./fake-ext.sh >/dev/null 2>&1 &)
# An ended session two days old: hidden, counted on the chip.
shell ENC=$(printf '%s' "$MNML_E2E_WORKSPACE" | sed 's/[\/.]/-/g') && printf '{"type":"user","cwd":"%s","message":{"role":"user","content":"old one"}}\n' "$MNML_E2E_WORKSPACE" > "home/.claude/projects/$ENC/e2e00000-0000-4000-8000-000000000003.jsonl" && touch -t "$(date -v-2d +%Y%m%d%H%M 2>/dev/null || date -d '2 days ago' +%Y%m%d%H%M)" "home/.claude/projects/$ENC/e2e00000-0000-4000-8000-000000000003.jsonl"
wait 300
command sessions.refresh
wait 1500
# (The count gives way to the history chip at the sidebar's width.)
expect screen contains "EXTERNAL"
expect screen contains "  main  (e2e00000)"
expect screen lacks "elsewhere"
expect screen lacks "old one"
expect screen contains "󰋚 1"
