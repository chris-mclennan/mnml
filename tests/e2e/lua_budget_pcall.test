# The 20 ms budget cannot be caught by the script it cuts. A `pcall`
# around a runaway loop used to swallow the abort, the loop around the
# `pcall` asked again, and the UI thread never came back — no frame, no
# key, 100% CPU. Now the script's `pcall` rethrows the trip: one toast,
# and the next command runs.
write .mnml/init.lua "mnml.command{ id = 'spin', run = function() while true do pcall(function() while true do end end) end end }\nmnml.command{ id = 'ok', run = function() mnml.toast('STILL-ALIVE') end }\n"
command script.reload
command! user.spin
# The toast reads `<workspace>/.mnml/init.lua:1: mnml: script budget
# exceeded` and word-wraps: where it breaks moves with the length of the
# temp dir the workspace is in (`$TMPDIR` on a Mac, `/tmp` on Linux), so
# the words are asked for one at a time.
expect screen contains "budget"
expect screen contains "exceeded"
command user.ok
expect screen contains "STILL-ALIVE"
