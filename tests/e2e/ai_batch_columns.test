# env: PATH=${MNML_SHIMS}/ai:${PATH}
# width: 120
# A batch's arrangement is a per-launch pick: each `Open ×N` row of the
# `+ New session` menu opens Tabs / Columns (and Grid from four up) to
# its right. ×3 ▸ Columns puts three sessions side by side, each the
# page's full height, and the pick is remembered — the next menu ticks
# Columns under ×4 too, the plain click's arrangement (`ai.batch_arrange`).
# `tools/shims/ai/claude` stands in for the CLI (it sleeps).
command view.activity_sessions
wait 300
rightclick 6 4
expect screen contains "Open ×3"
hover 15 9
expect screen contains " Tabs    │"
expect screen contains "✓ Columns │"
expect screen lacks "Grid"
click 56 11
wait 600
expect screen contains "opened 3 Claude sessions side by side"
# Each column's strip keeps its pane buttons beside the whole name.
expect screen contains "│ 󱸀 claude 󰅖    󱸀  󲀀       │ 󱸀 claude 󰅖    󱸀  󲀀       │ 󱸀 claude 󰅖"
expect screen lacks "New local session"
rightclick 6 4
hover 15 10
expect screen contains "✓ Columns │"
expect screen contains " Grid    │"
key esc
key esc
# With a file open first (`view.only` gathers the page into its one
# leaf), the editor keeps the width the first session's split leaves
# it and the three new sessions share only the rest — the editor is
# not made a fourth equal column.
write a.txt "alpha\n"
open a.txt
command view.only
rightclick 6 4
hover 15 9
click 56 11
# Under load the three sessions start late: wait for their toast and
# for the row to settle into four columns rather than reading it once.
expect within 20000 screen contains "opened 3 Claude sessions side by side"
# The editor's column is half the row; the sessions a third of the
# other half each.
# The exact widths are the unit test's; here only that the editor kept its
# column and the sessions opened beside it.
expect within 20000 screen contains "│▌  1 alpha"
