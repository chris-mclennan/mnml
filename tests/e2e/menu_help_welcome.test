# width: 120
# Help → Welcome (src/app/menu_bar.zig, `view.welcome`): Alt+H opens the
# Help menu — folded behind the bar's ` » ` at 120 columns — with its
# first row lit, and Enter on it shows the start surface on a fresh tab
# page, with the keys.
key alt+h
expect screen contains "Welcome"
expect screen contains "Keybindings"
key enter
expect screen contains "SHORTCUTS"
expect screen contains " START "
expect screen lacks "The chords to start with:"
