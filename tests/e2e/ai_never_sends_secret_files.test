# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# Ghost text already refused to send a secret-bearing file (`.env*`,
# `id_rsa`, `*.pem`, names with token / secret / credential…). Every
# other AI path now uses the same list: `ai.chat` sends the question
# without the file and says so, the actions refuse, and a diff handed
# to a model has the secret file's hunks withheld. The fake `claude`
# keeps what it was sent on stdin, so the check is the wire.
write bin/claude #!/bin/sh\ncat >> sent.txt\nprintf 'Add the widget\\n'
shell chmod +x bin/claude
write .env "DB_PASSWORD=hunter2-fake-value\n"

# ai.chat with .env focused: the question goes, the file does not.
open .env
command ai.chat
type "why does my app not start"
key enter
wait 1200
expect screen contains "not attached"
expect file sent.txt contains "why does my app not start"
expect file sent.txt lacks "hunter2-fake-value"

# ai.explain on it: refused before anything runs.
shell rm -f sent.txt
open .env
command ai.explain
wait 800
expect screen contains ".env not sent"
shell test ! -e sent.txt

# A commit message for a change that includes .env: its hunks withheld.
shell git init -q -b main && git config user.email t@example.com && git config user.name t
write .gitignore ".mnml/\nbin/\nsent.txt\n"
write a.txt "one\n"
shell git add .gitignore a.txt && git commit -q -m init
write a.txt "one\ntwo\n"
write .env "DB_PASSWORD=hunter3-fake-value\n"
shell git add -f a.txt .env
open a.txt
command git.ai_commit
wait 1500
expect file sent.txt contains "+two"
expect file sent.txt contains "(withheld: .env"
expect file sent.txt lacks "hunter3-fake-value"
