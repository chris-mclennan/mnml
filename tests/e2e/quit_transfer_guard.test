# `app.quit` (Ctrl+Q, the palette) asks the same transfer guard `:qa`
# does (src/app/transfers.zig quitGuard): a copy in flight is refused
# with the count, so the standard profile cannot leave a half-written
# tree behind. The tree is big enough that the worker is still copying
# when the chord lands (the runner ticks between steps); the unit test
# in transfers.zig pins the guard without the clock.
shell mkdir -p big out && i=0; while [ $i -lt 3000 ]; do head -c 4096 /dev/zero > big/f$i.bin; i=$((i+1)); done
command files.open
expect screen contains "out/"
# Row 0 is big/: mark it (the cursor steps onto out/), copy, enter out/, paste.
key space
expect screen contains "✓1"
key ctrl+c
expect screen contains "copied big"
key enter
expect screen contains "› out"
key ctrl+v
key ctrl+q
expect screen contains "transfer(s) still running"
# The toast is the message; the flag is the fact. A refused quit leaves
# the App running, and this is the only check that says so directly.
expect quit false
wait 3000
expect screen contains "copy finished"
expect file out/big/f2999.bin contains ""
