write requests/a.http "GET https://x/a\n"
write requests/b.http "GET https://x/b\n"
command view.activity_http
expect screen contains "COLLECTIONS (2)"
expect screen contains "requests (2)"
expect screen contains "a.http"
click 28 5
expect screen contains "req-1.http"
expect screen contains "new request in requests: req-1.http"
click 12 5
expect screen lacks "a.http"
expect screen contains "requests (2)"
