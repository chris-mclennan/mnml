# The `:` line's completion popup — standard profile, over the app's
# own `:` line (`Ctrl+;`, or a click on the bottom row), which has no
# vim handler under it: the same popup, the same keys, and a click on a
# row writes it into the line. At 120x40 the `:` line is row 39, the
# frame's bottom border row 38, its left edge column 1. Esc over the
# typed text puts the popup away and keeps the line; on a written
# candidate it closes the line.

write data.txt "alpha"
open data.txt
command editor.use_standard

# An empty line is no popup (every id matches an empty token; a wall
# of the whole registry is not a suggestion). The checks below name
# the popup's own rows — a toast's box shares the frame glyphs.
key ctrl+;
expect screen contains ":▏"
expect screen lacks "│ dock"
type "do"
expect screen contains ":do▏"
expect screen contains "│ dock.add_preset"

# Tab writes the first row — `dock`, the ex verb, heads the ids — the
# next Tab the second; Shift+Tab walks back.
key tab
expect screen contains ":dock▏"
expect screen contains "│ dock.close_all"
key tab
expect screen contains ":dock.add_preset▏"
key shift+tab
expect screen contains ":dock▏"
key enter
expect screen lacks ":dock▏"
expect screen contains "New terminal"
command view.dock_toggle

# ── a click on a row writes it ──
# The frame is rows 28..38 (eight rows, the hint, the border); row 0
# (`dock`) is on 29, row 1 on 30, their text from column 2.
key ctrl+;
type "do"
expect screen contains "│ dock.add_preset"
click 4 30
expect screen contains ":dock.add_preset▏"
expect screen contains "│ dock.close_all"

# On a written candidate Esc is the line's own: one press closes it.
key esc
expect status contains "\"cmdline\":false"

# ── over the typed text, Esc puts the popup away, then the line ──
key ctrl+;
type "do"
expect screen contains "│ dock.add_preset"
key esc
expect screen lacks "│ dock.add_preset"
expect screen contains ":do▏"
expect screen contains "CMD"
key esc
expect status contains "\"cmdline\":false"

# ── one candidate: no popup, Tab still completes ──
key ctrl+;
type "tabclos"
expect screen contains ":tabclos▏"
expect screen lacks "│ tabclose"
key tab
expect screen contains ":tabclose▏"
expect screen lacks "│ tabclose"
key esc
