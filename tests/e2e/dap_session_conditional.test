# DAP session — a conditional breakpoint skips until its condition is
# true. `tick` runs four times; the breakpoint on its body line carries
# `i == 2`, so the first two hits are passed over and the stop lands
# with i already 2. Both frames are on the stack: the function and the
# `call` that entered it. continue runs the program out: it prints 4 and
# exits 0.
write prog.dbg "let i = 0\nfn tick\n  i = i + 1\nend\ncall tick\ncall tick\ncall tick\ncall tick\nprint i\n"
write .mnml/config.zon .{ .dap = .{ .dbg = .{ .cmd = "$MNML_FAKE_DAP" } } }
open prog.dbg
command editor.use_vim

# Line 3: `i = i + 1`.
key j
key j
command dap.toggle_breakpoint_conditional
expect screen contains "Breakpoint condition (line 3)"
type "i == 2"
key enter
expect screen contains "bp line 3: i == 2"

command dap.run
expect screen contains "dap: stopped (breakpoint)"
# The stop's jump to the line (the ▶ in the gutter) lands after the toast;
# the panes below are opened once it has, so the jump does not take focus back.
expect screen contains "▶"
command dap.show
expect screen contains "prog.dbg:3  tick"
expect screen contains "prog.dbg:7  main"
expect screen contains "i: int = 2"

command dap.continue
expect screen contains "dap: exited (code 0)"
