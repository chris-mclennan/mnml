# width: 120
# height: 40
# A failed refresh leaves a stale list with nothing on it saying so,
# and the reader has to already know that `r` is refresh. Since wire
# protocol 3 the message carries the way back: mnml paints the pane's
# `action` as the button in the toast's own box.
#
# Driven for real — the fake is killed and the pane asked to refresh —
# so what is asserted is the whole path: the integration attaches the
# offer, the SDK puts it on the wire, the host reads it and paints it.
# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --lifetime-secs 16 >/dev/null 2>&1 &
wait 600
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket: open pull requests\", .chip = .{ .glyph = \"\u{f00a8}\", .fallback = \"BP\", .color = \"blue\", .in_palette_bar = false }, .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket_prs"
command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
wait 6000
expect screen contains "BITBUCKET PRS"
expect screen contains "Fix the login redir"

# The service goes away under the pane — the fake is started with a
# short `--lifetime-secs` and simply stops, so nothing here has to kill
# a process it might share with another run. `R` refreshes past every
# cache, so the pane really asks and really fails.
wait 14000
key R
# Short, because a toast has a life: the box has to still be up.
wait 2500
# The message, and the offer attached to it. ` Retry ` is the button in
# the box, on its own row inside the frame — the pane never had one
# before protocol 3, so the only way back was knowing the key.
expect screen contains "Bitbucket PRs: error:"
expect screen contains " Retry "
