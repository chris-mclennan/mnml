# A STASHES row: the short sha and the message; a second click shows
# the stash's files (git-more2 — Enter used to apply); the row menu's
# Apply keeps the stash and puts the change back. Rows at 120x40:
# LOCAL 7, main 8, gap 9, REMOTE 10, gap 11, WORKTREES 12, main 13,
# gap 14, STASHES 15, the stash 16.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write .gitignore ".mnml/\n"
write a.txt "one\n"
shell git add .gitignore a.txt
shell git commit -q -m "init"
write a.txt "two\n"
shell git stash push -q -m "keep this"
expect file a.txt contains "one"
command view.activity_git
wait 1000
expect screen contains "󰅀 󰏗 STASHES"
expect screen contains "On main: keep this"
click 6 16
click 6 16
wait 1500
expect screen contains "M  a.txt"
expect file a.txt contains "one"
rightclick 6 16
expect screen contains "Show files (Enter)"
expect screen contains "Apply (keep)"
key down
key enter
wait 1500
expect file a.txt contains "two"
expect screen contains "On main: keep this"
