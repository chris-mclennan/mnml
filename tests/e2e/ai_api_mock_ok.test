# env: MNML_ANTHROPIC_BASE_URL=http://127.0.0.1:${SERVE_PORT}
# env: ANTHROPIC_API_KEY=fake-key-for-a-mock
# env: PATH=${MNML_E2E_WORKSPACE}/no-bin
# The API backend against a mock Messages server (`MNML_ANTHROPIC_BASE_URL`
# — never the real host). No `claude` on PATH and a key set: the default
# route is the API. A 200 reply's text is the answer.
# `serve 0`: the runner binds a free port before the file starts and
# `${SERVE_PORT}` names it — a fixed port collided when two runs of the
# corpus shared a machine.
serve 0 200 "content-type: application/json\n\n{\"id\":\"m1\",\"type\":\"message\",\"role\":\"assistant\",\"stop_reason\":\"end_turn\",\"content\":[{\"type\":\"text\",\"text\":\"MOCK ANSWER FROM THE API\"}],\"usage\":{\"input_tokens\":1,\"output_tokens\":2}}"
command ai.ask
type "hello"
key enter
wait 1000
expect screen contains "MOCK ANSWER FROM THE API"
expect screen contains "done"
