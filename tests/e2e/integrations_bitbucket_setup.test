# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/never-written.zon
# A pane with no config and no token. The failure mode worth guarding
# against is a pane that opens, finds nothing, and closes again with a
# banner — leaving the user with no idea what is missing. Instead it
# paints the setup screen, names what is wrong, and lists the three
# steps. `q` closes it.
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket pull requests\", .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
key i
expect screen contains "installed bitbucket_prs"
# The corpus lays its screens out at full width: the pane opens as a tab,
# not beside whatever the install left active (`integrations.open_as`).
command integrations.open_as_tab
command bitbucket_prs.open
command view.focus_pane
wait 900
expect screen contains "BITBUCKET — setup"
# The first run writes the scaffold and says where, so there is a file
# to edit rather than an error to decode. Where: the absolute path, which
# is as long as the runner's TMPDIR makes it and is clipped at the pane's
# edge — so the screen is asked for the part every TMPDIR keeps (the
# workspace's own directory) and the file for the rest. The file name at
# the path's END was the assertion once, and a TMPDIR inside a checkout
# clipped it off.
expect screen contains "/mnml-e2e-"
expect file never-written.zon contains "mnml-bitbucket — your Bitbucket Cloud workspace"
expect screen contains "edit config.zon"
expect screen contains "BITBUCKET_API_TOKEN"
expect screen contains "mnml-bitbucket --check"
key q
wait 500
key x
expect screen lacks "BITBUCKET — setup"

# The corpus shares one data root: leave it as it was found, or the
# INTEGRATIONS rows every later script counts are this one's too.
command integrations.show_installed
key x
expect screen contains "Remove integration"
expect screen contains "bitbucket_prs"
key enter
expect screen contains "Remove Bitbucket PRs?"
key r
expect screen contains "removed bitbucket_prs"
expect screen lacks "Bitbucket PRs"
