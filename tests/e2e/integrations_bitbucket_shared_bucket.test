# width: 120
# height: 40
# The forge pane on a machine-wide shared bucket file
# (`budget.shared_bucket`, `sdk.budget.Bucket`): with no tokens in it
# the pane waits — it says so, and nothing reaches the wire — and once
# the bucket has tokens the same pane loads, spending them.
#
# The wire (`--log-file`) is the proof that nothing was sent; the bucket
# file itself is the proof that what was sent was paid for.
# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --life-secs 180 --log-file wire.jsonl >/dev/null 2>&1 &
# Empty, and never refilling: rate 0.
write shared.json "{\"rate_per_sec\":0,\"burst\":50,\"tokens\":0,\"updated_at\":0,\"cooldown_until\":null,\"last_429_at\":null,\"owner\":\"fleet\"}"
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .account_id = \"acct-max\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .budget = .{ .shared_bucket = \"shared.json\" }, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket: open + merged pull requests across the workspace\", .chip = .{ .glyph = \"\u{f00a8}\", .fallback = \"BP\", .color = \"blue\", .in_palette_bar = false }, .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket_prs"
command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
expect within 30000 screen contains "BITBUCKET PRS"
# The pane waits, and says why — on the rows and on the hint line.
expect within 20000 screen contains "waiting on the shared"
wait 1500
# Nothing reached the wire, and nothing was taken.
shell test ! -s wire.jsonl || { cat wire.jsonl; exit 1; }
expect file shared.json contains "\"tokens\":0"
# The fleet's own key is still in the file the pane rewrote.
expect file shared.json contains "\"owner\":\"fleet\""

# Tokens arrive; `r` asks again, and this time it goes.
write shared.json "{\"rate_per_sec\":0,\"burst\":50,\"tokens\":50,\"updated_at\":0,\"cooldown_until\":null,\"last_429_at\":null}"
key r
expect within 20000 screen contains "(2 repos · 3 PRs)"
expect file wire.jsonl contains "acme/api/pullrequests"
# One token per request on the wire.
shell n=$(grep -c . wire.jsonl); left=$(sed 's/.*"tokens":\([0-9.]*\).*/\1/' shared.json); left=${left%%.*}; echo "wire=$n tokens_left=$left"; test "$((left + n))" -eq 50

key q
wait 500
