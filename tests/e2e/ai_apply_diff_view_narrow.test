# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# The review of a proposal in a pane narrower than `split_min_w` opens in
# the git diff view's Hunk view rather than Split, and `q` rejects it
# (what an `openDiff` answers DIFF_REJECTED): the file is left as it was.
write bin/claude #!/bin/sh\ncat >/dev/null\nprintf 'Here:\\n\\n```\\nALPHA\\nb\\nc\\n```\\n'
shell chmod +x bin/claude
write d.txt "a\nb\nc\n"
open d.txt
command ai.fix
wait 1200
expect screen contains "ALPHA"
key a
expect screen contains "1 of 1 hunk accepted"
expect screen contains "v @@ -1,3 +1,3 @@"
expect screen contains "[✓ accept]"
key q
expect screen lacks "hunk accepted"
expect file d.txt contains "a\nb\nc\n"
expect file d.txt lacks "ALPHA"
