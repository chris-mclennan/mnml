# width: 160
# height: 60
# env: PATH=/usr/bin:/bin
# A tagged template — styled-components css`…`, lit html`…`, sql`…` — and
# a regex literal carry their own language in .ts exactly as in .js: the
# TypeScript entry takes JavaScript's injections.
write styles.js "const Button = css`\n  color: red;\n  margin: 0;\n`;\nconst page = html`<div class=\"x\">hi</div>`;\nconst q = sql`SELECT id FROM users`;\nconst re = /ab+[0-9]{2}$/;\n"
open styles.js
wait 400
expect screen contains "color: red;"
# control: .js — `color` is a css property (#e06c75), SELECT a sql keyword (#c678dd)
expect color 40 3 fg #e06c75
expect color 52 7 fg #c678dd
write styles.ts "const Button = css`\n  color: red;\n  margin: 0;\n`;\nconst page = html`<div class=\"x\">hi</div>`;\nconst q = sql`SELECT id FROM users`;\nconst re = /ab+[0-9]{2}$/;\n"
open styles.ts
wait 400
expect pane "styles.ts"
# the same text in .ts
expect color 40 3 fg #e06c75
expect color 52 7 fg #c678dd
