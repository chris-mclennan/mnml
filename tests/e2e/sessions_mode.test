# sizes: all
# env: HOME=home
# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# The sessions mode (`app/sessions_mode.zig`): five stand-in sessions
# stacked behind b.txt, a split beside it. `sessions.mode` (the
# Sessions row of the activity bar) puts that layout aside and shows the
# sessions in `ai.session_columns` = 2 columns, dealt round-robin in the
# rail's order: 1 3 5 | 2 4. Each strip's ` ‹ n/m › ` is the session's
# place in its column. Ctrl+Tab / Ctrl+Shift+Tab step the focused
# column's stack and the keys stay; Ctrl+N shows the rail's Nth session
# in the focused column, trading places with the one there. Closing a
# column's last session keeps two columns: the next session stacked
# behind another column fills it. Leaving puts the split back, the
# surviving sessions as tabs behind b.txt. Both profiles' chords.
# The stand-in is the demo shim's shape (`data/demo/bin/claude`: it
# names its pane through the window title and stays up) with a number
# in the title, so the five can be told apart.
write bin/claude #!/bin/bash\nn=$(cat .n 2>/dev/null || echo 0); n=$((n+1)); echo $n > .n\nprintf '\\033]0;claude %s\\007' $n\nprintf 'fake claude %s\\n' $n\nexec sleep 600
shell chmod +x bin/claude
write a.txt "alpha alpha"
write b.txt "bravo bravo"
open a.txt
command view.split_right
open b.txt
command ai.claude_code_new_tab
wait 300
command ai.claude_code_new_tab
wait 300
command ai.claude_code_new_tab
wait 300
command ai.claude_code_new_tab
wait 300
command ai.claude_code_new_tab
wait 300
open b.txt
command sessions.mode
wait 300
expect screen contains "fake claude 1"
expect screen contains "fake claude 2"
expect screen lacks "alpha alpha"
expect screen lacks "bravo bravo"
expect screen contains "‹ 1/3 ›"
expect screen contains "‹ 1/2 ›"
expect pane claude 1
key ctrl+tab
expect pane claude 3
expect screen contains "│▌fake claude 3"
expect screen contains "‹ 2/3 ›"
expect screen contains "fake claude 2"
key ctrl+shift+tab
expect pane claude 1
key ctrl+4
expect pane claude 4
expect screen contains "fake claude 4"
expect screen contains "fake claude 2"
expect screen contains "│ 󱸀 claude 4 󰅖"
command buffer.close
wait 200
expect pane claude 3
command view.focus_right
expect pane claude 2
command buffer.close
wait 200
expect pane claude 1
command buffer.close
wait 200
expect screen contains "│▌fake claude 3"
expect screen contains "│▌fake claude 5"
expect pane claude 5
command sessions.mode
wait 200
expect screen contains "alpha alpha"
expect screen contains "bravo bravo"
expect pane b.txt
expect screen contains "claude 3"
# vim: the same chords, from inside a session.
command editor.use_vim
command sessions.mode
wait 200
expect screen lacks "alpha alpha"
expect screen contains "│▌fake claude 3"
expect screen contains "│▌fake claude 5"
# One column (one session maximised): both stacked in it.
command sessions.columns_1
wait 200
expect screen contains "‹ 1/2 ›"
expect pane claude 3
key ctrl+tab
expect pane claude 5
expect screen contains "‹ 2/2 ›"
key ctrl+1
expect pane claude 3
command sessions.mode
wait 200
expect screen contains "alpha alpha"
expect pane b.txt
