# A grep hit on a line wider than 65535 cells (data/nerd-glyphnames.json
# in this repo is one 545k-char line) overflowed the u16 vaxis sums cells
# into: the Search pane measured the whole prefix before clipping it and
# the process aborted. The row is now a window around the match: `…`,
# ~40 cells of context, the match, and the tail clipped to the row.
write short.txt "zzlong here\n"
write long.txt "zzlong  and the tail\n"
write deep.txt " zzlong deep\n"
open short.txt
command find.grep
type zzlong
key enter
wait 600
expect screen contains SEARCH
expect screen contains "3 matches in 3 files"
expect screen contains "long.txt (1)"
expect screen contains "deep.txt (1)"
expect screen contains "short.txt (1)"
# The long hits paint (they were the crash). A match at the head of the
# line keeps its head and clips the tail; one deep in the line shows
# `…`, the context before it, the match and the tail.
expect screen contains "1:1  zzlong yyyy"
expect screen contains "1:70002  …wwww"
expect screen contains "wwww zzlong deep"
