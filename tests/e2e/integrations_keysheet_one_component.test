# width: 120
# height: 40
# env: JIRA_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/jira-bucket.json
# env: JIRA_API_TOKEN=fake-token
# env: JIRA_BASE_URL=@${MNML_E2E_WORKSPACE}/jira.url
# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# The ? key sheet is ONE component on both panes of the family
# (sdk.pane.chrome.Painter.keySheet): the same title, the same counted
# section headers, the same chord spelling, the same Esc footer.
# hunt/findings-2026-09-23/integ-keysheet-two-components.md (the
# hunter's repro).
# Both fakes first: the Jira pane reads $BITBUCKET_BASE_URL for its
# linked PRs, and an @file that is not there yet stops it, loudly.
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --lifetime-secs 180 >/dev/null 2>&1 &
shell "$MNML_FAKE_JIRA" --port 0 --url-file jira.url --life-secs 180 --quiet --log-file jira.log --pid-file fake-jira.pid >/dev/null 2>&1 &
wait 500
write sdk/mnml-sdk/build.zig ""
write integrations/jira/build.zig ""
write integrations/jira/manifest.zon ".{ .id = \"jira_work\", .label = \"Jira Work\", .version = \"0.2.0\", .binary = \"$MNML_JIRA\", .category = \"tracker\", .commands = .{ .{ .id = \"jira_work.open\", .title = \"Jira Work\", .args = .{ \"--only\", \"work\" } } } }"
write .mnml/integrations/jira/config.zon ".{ .jira_url = \"https://jira.invalid\", .email = \"fake@acme.com\", .refresh_interval_secs = 0, .rate = .{ .per_sec = 1000, .burst = 1000 }, .tabs = .{ .{ .name = \"My open work items\", .kind = .work_open } } }"
command integrations.show_in_dev
expect screen contains "INTEGRATIONS"
drag 30 5 60 5
key i
expect within 10000 screen contains "installed jira_work from"
expect within 10000 screen lacks "installed jira_work from"
command integrations.open_as_tab
command view.toggle_tree
command jira_work.open
expect within 30000 screen contains "JIRA WORK (3)"
expect within 30000 file jira.log contains "issueId=10005"
command view.focus_pane
wait 1000
key ?
expect screen contains "┌ Keys "
expect screen contains "▾ ── navigation ──"
expect screen contains "j/k scroll · Esc close"
expect screen contains "PgDn"
key esc
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket PRs\", .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
key i
expect screen contains "installed bitbucket_prs"
command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
expect within 15000 screen contains "(2 repos · 3 PRs)"
key ?
expect screen contains "┌ Keys "
expect screen contains "▾ ── navigation ──"
expect screen contains "j/k scroll · Esc close"
expect screen contains "PgDn"
expect screen lacks "any other key closes"
key z
expect screen contains "┌ Keys "
key esc
expect screen lacks "┌ Keys "
shell kill "$(cat fake-jira.pid)" 2>/dev/null || true
