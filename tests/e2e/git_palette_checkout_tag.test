# A TAGS row: a second click asks before checking the tag out detached;
# `y` does it. Rows at 120x40: LOCAL 5, main 6, gap 7, REMOTE 8, gap
# 9, WORKTREES 10, main 11, gap 12, STASHES 13, gap 14, TAGS 15, v1 16.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write .gitignore ".mnml/\n"
write a.txt "one\n"
shell git add .gitignore a.txt
shell git commit -q -m "init"
shell git tag v1
write a.txt "two\n"
shell git commit -q -am "second"
command view.activity_git
wait 1000
expect screen contains " 󰓻 TAGS"
expect screen contains "  󰓹 v1"
click 6 18
click 6 18
expect screen contains "Checkout tag v1? (detached HEAD)"
key y
wait 1500
expect file .git/HEAD lacks "refs/heads"
expect screen lacks "󰄬 󰘬 main"
