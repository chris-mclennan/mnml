# gd must record a jump: Ctrl-O comes back to where gd was pressed
# (Neovim/NvChad: gd is vim.lsp.buf.definition, which pushes the jumplist).
write src/main.fk "fn foo() {\n  let x = 1;  \n  foo(x); // TODO later\n}\nfn bar() { foo(); }\n"
write .fkroot ""
write .mnml/config.zon .{ .lsp = .{ .fake = .{ .cmd = "$MNML_FAKE_LSP", .args = .{ "--log", "lsp.log" }, .extensions = .{ "fk" }, .root_markers = .{ ".fkroot" } } } }
open src/main.fk
command editor.use_vim
expect screen contains "LSP 1"
key j
key j
key w
expect screen contains "Ln 3/5 Col 3"
key g
key d
expect screen contains "Ln 1/5 Col 4"
key ctrl+o
expect screen contains "Ln 3/5 Col 3"
