# Three documented, keybound ids that only toasted `not implemented
# yet`: search.toggle_regex flips the Search pane's regex flag and
# reruns; view.activity_integrations (ctrl+shift+x) is the Integrations
# pane; view.image_open picks an image file and opens it as an image pane.
write a.txt "alpha\n"
open a.txt
command find.grep
type alpha
key enter
wait 600
expect screen contains "1 match in 1 file"
command search.toggle_regex
expect screen contains "search regex: on"
expect screen lacks "not implemented"
command view.activity_integrations
expect screen contains INTEGRATIONS
expect screen lacks "not implemented"
shell printf 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==' | base64 -d > pic.png
command view.image_open
expect screen contains "Images"
expect screen contains "pic.png"
key enter
expect pane pic.png
expect screen lacks "not implemented"
