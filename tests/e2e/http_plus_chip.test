# The HTTP panel header carries a green `+` chip before its ⟳: a click
# opens a blank request pane. A right-click on a request field opens a
# menu titled by that field.
write a.txt alpha
open a.txt
command view.activity_http
expect screen contains "HTTP (0)"
# HTTP is a left section; on the right (32 cells, its header the
# column's first row — a section gets no strip) it keeps the `+` at
# column 116.
command view.move_section_right
expect screen contains "HTTP (0)"
click 116 1
expect screen contains "new request"
expect screen contains "Send"
# The Body content is row 9 (the Request box's strip is rows 7 / 8);
# the URL box's text row is 4, from column 45 on this half-width pane.
rightclick 40 9
expect screen contains "╭ Body"
expect screen contains "Paste curl from clipboard"
key esc
rightclick 50 4
expect screen contains "╭ URL"
key esc
expect screen lacks "╭ URL"
