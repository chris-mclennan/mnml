# Vim `:%s/old/new/[flags]` (whole-buffer) and bare `:s/old/new/[flags]`
# (current-line only). Mnml extension: `g` flag is implicit for `:%s`.

# ─── :%s/old/new/ — buffer-wide ─────────────────────────────────────
write doc.txt "alpha\nbeta alpha\ngamma alpha"
open doc.txt
command editor.use_vim

# Replace every "alpha" with "ALPHA" across the whole buffer.
type ":%s/alpha/ALPHA/"
key enter
command file.save

expect file doc.txt contains "ALPHA"
expect file doc.txt lacks "alpha"

# ─── :%s/old/new/gi — case-insensitive, all matches ──────────────────
# Vim canonical: `/g` is required to replace every match on a line
# (nvchad-round-12 SEV-2 2026-07-14 fix — was implicitly global before).
write case.txt "Foo bar FOO baz foO"
open case.txt
command editor.use_vim
type ":%s/foo/Q/gi"
key enter
command file.save
# All three variants replaced via the i flag + g for per-line-global.
expect file case.txt contains "Q bar Q baz Q"

# ─── :%s/old// — empty replacement deletes ──────────────────────────
# Substitute is regex-first (nvchad-round-7 SEV-2 2026-07-11) so `[` /
# `]` are character-class metachars — escape with `\[` / `\]` for a
# literal bracket match.
write del.txt "keep [drop] keep"
open del.txt
command editor.use_vim
type ":%s/\[drop\] //"
key enter
command file.save
expect file del.txt contains "keep keep"

# ─── :s/old/new/g — current-line scope only, all matches on line ─────
write scope.txt "x x x\ny y y\nz z z"
open scope.txt
command editor.use_vim
# Move to line 2 (the y's). Then bare :s should only touch that line.
key j
type ":s/y/W/g"
key enter
command file.save
# All three y's on row 2 replaced (needs /g), other rows untouched.
expect file scope.txt contains "x x x\nW W W\nz z z"
