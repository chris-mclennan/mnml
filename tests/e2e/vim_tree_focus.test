# NvChad: `<leader>e` is NvimTreeFocus — the tree takes the keys, opened
# first when hidden, never hidden; `<C-n>` is NvimTreeToggle — the tree
# it opens is focused, so `j` moves the tree cursor, not the editor's.
write a.txt "alpha\nbravo\ncharlie\n"
open a.txt
command editor.use_vim
expect screen contains "NORMAL"

key space
key e
expect screen contains "TREE"
key j
expect screen contains "Ln 1/3"
key ctrl+n
expect screen lacks "TREE"
expect screen contains "NORMAL"
key ctrl+n
expect screen contains "TREE"
key esc
expect screen contains "NORMAL"
key j
expect screen contains "Ln 2/3"
