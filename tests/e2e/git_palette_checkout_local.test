# The branches panel (src/app/git_palette.zig): a click on a LOCAL row
# selects it; a second click on the same row checks the branch out
# through the worker. The screen is 120x40: the sidebar snaps to 24,
# the GIT header is row 1, the filter row 2, the pill row 4, the list
# starts on row 7 (LOCAL), feature on 8, main on 9.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write .gitignore ".mnml/\n"
write a.txt "one\n"
shell git add .gitignore a.txt
shell git commit -q -m "init"
shell git branch feature
command view.activity_git
wait 1000
expect screen contains "Viewing 3"
expect screen contains " 󰌢 LOCAL"
expect screen contains "󰄬 󰘬 main"
expect screen contains "  󰘬 feature"
click 6 8
click 6 8
wait 1500
expect file .git/HEAD contains "refs/heads/feature"
expect screen contains "󰄬 󰘬 feature"
expect screen contains "  󰘬 main"
