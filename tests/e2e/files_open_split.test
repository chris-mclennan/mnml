# zig-only
# `files.open_split` opens a second Files pane in a new leaf: two
# strips each with their own ` 󰝰 sub 󰅖 ` tab and `󰐕`, never two
# Files tabs on one strip.
write sub/a.txt "a"
command files.open
key enter
expect screen contains "› sub"
command files.open_split
expect screen lacks "sub 󰅖   󰝰 sub"
expect screen contains "󰝰 sub 󰅖   󰐕"
