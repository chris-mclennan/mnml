# Inline values — while stopped, every line up to the stop that names
# a variable of the scope shows its value after the text, dimmed.
write prog.dbg "let x = 1\nlet p = struct{a=1,b=\"two\"}\nprint \"hello\"\nx = x + 1\nfn f\n  let y = 10\n  x = x * y\nend\ncall f\nprint x\n"
write .mnml/config.zon .{ .dap = .{ .dbg = .{ .cmd = "$MNML_FAKE_DAP" } } }
open prog.dbg
command editor.use_vim
type 3j
command dap.toggle_breakpoint
command dap.run
expect screen contains "dap: stopped (breakpoint)"
expect screen contains "x = x + 1  x = 1"
expect screen contains "let x = 1  x = 1"
expect screen contains "b=\"two\"}  p = {a=1"
command dap.next
expect screen contains "dap: stopped (step)"
expect screen contains "x = x + 1  x = 2"
command dap.terminate
expect screen contains "dap: terminated"
expect screen lacks "x = x + 1  x = 2"
