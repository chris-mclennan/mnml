# Vim normal `R` — Replace mode. Typed chars overwrite existing chars and
# advance the cursor (inserts past EOL). Esc returns to Normal.

write data.txt "abcdef"
open data.txt
command editor.use_vim

# Cursor on 'a'. R enters Replace mode. Type "XYZ" — overwrites "abc"
# leaving "XYZdef".
key R
type "XYZ"
key escape

command file.save
expect file data.txt contains "XYZdef"

# From "XYZdef", `A` puts the cursor past 'f'; Esc steps back ONTO 'f'
# (vim: Esc moves left one column, never off the line). `R` + `!` then
# overwrites the 'f' — vim 9 gives "XYZde!". The earlier expectation of
# "XYZdef!" only came out when two bugs cancelled: a save parked the
# cursor on a phantom line and Esc crossed back onto the newline.
key A
key escape
key R
type "!"
key escape
command file.save
expect file data.txt contains "XYZde!"
expect file data.txt lacks "XYZdef!"

# Backspace in Replace mode restores the original char (vim canonical).
write back.txt "abcdef"
open back.txt
key R
type "12"
key backspace
key backspace
key escape
command file.save
# Both overwrites should be restored — file unchanged.
expect file back.txt contains "abcdef"
