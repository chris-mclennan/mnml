# Go to definition through the fake server: `foo` on line 3 resolves
# to the `fn foo` line, and the caret lands on the name (line 1,
# character 3 — the position chip says Col 4).
write src/main.fk "fn foo() {\n  let x = 1;  \n  foo(x); // TODO later\n}\nfn bar() { foo(); }\n"
write .fkroot ""
write .mnml/config.zon .{ .lsp = .{ .fake = .{ .cmd = "$MNML_FAKE_LSP", .args = .{ "--log", "lsp.log" }, .extensions = .{ "fk" }, .root_markers = .{ ".fkroot" } } } }
open src/main.fk
expect screen contains "LSP 1"
# Line 3, on `foo`.
key down
key down
key right
key right
key right
expect screen contains "Ln 3/5 Col 4"
command lsp.goto_definition
expect screen contains "Ln 1/5 Col 4"
