# A name Finder wrote decomposed (e + U+0301) is found by the composed
# "é" the keyboard types, and by a plain "ecole".
# Octal escapes, not \x: dash's printf (Linux's /bin/sh) has no \x and
# writes the backslash through.
shell echo x > "$(printf 'e\314\201cole-notes.txt')" && echo y > other.txt
key ctrl+p
type école
wait 300
expect screen lacks "(no matches)"
expect screen contains "cole-notes.txt"
key esc
key ctrl+p
type ecole
wait 300
expect screen contains "cole-notes.txt"
