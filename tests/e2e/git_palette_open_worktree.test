# A WORKTREES row: the main tree carries the house, a linked tree the
# tree glyph; a second click on a linked tree opens it — its directory
# joins the workspace and the graph tab switches to it. Rows at
# 120x40: LOCAL 5, feat 6, main 7, gap 8, REMOTE 9, gap 10, WORKTREES
# 11, main (ws) 12, feat (wt) 13.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write .gitignore ".mnml/\nwt/\n"
write a.txt "one\n"
shell git add .gitignore a.txt
shell git commit -q -m "init"
shell git worktree add -q wt -b feat
command view.activity_git
wait 1000
expect screen contains "󰅀 󰐅 WORKTREES"
expect screen contains "󰄬 󰋜 main"
expect screen contains "  󰐅 feat (wt)"
click 6 14
click 6 14
wait 1500
expect screen contains "󰊢 wt "
expect screen contains " wt 󰅀"
expect screen contains "󰄬 󰘬 feat"
