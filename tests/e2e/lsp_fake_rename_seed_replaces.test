# The rename prompt is seeded with the symbol AS A SELECTION: typing
# replaces it. Before, the seed sat with the caret after it and a typed
# name was appended (`foo` + `quux` = `fooquux`) — the overlay
# text-field rule: a field whose seed is the current value starts
# selected. Enter on the untouched seed still keeps it.
write src/main.fk "fn foo() {\n  let x = 1;  \n  foo(x); // TODO later\n}\nfn bar() { foo(); }\n"
write .fkroot ""
write .mnml/config.zon .{ .lsp = .{ .fake = .{ .cmd = "$MNML_FAKE_LSP", .args = .{ "--log", "lsp.log" }, .extensions = .{ "fk" }, .root_markers = .{ ".fkroot" } } } }
open src/main.fk
expect screen contains "LSP 1"
key down
key down
key right
key right
key right
command lsp.rename
expect screen contains "Rename symbol"
type "quux"
key enter
expect screen contains "LSP rename · applied 3 edit(s)"
expect screen contains "fn quux() {"
expect screen lacks "fooquux"
