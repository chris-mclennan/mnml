# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
# The Bitbucket PRs chip driven as a real mounted pane, against the
# deterministic Bitbucket in integrations/bitbucket/tools/fake_bitbucket.
# The screens are docs/ui-spec/bitbucket/rust-full-*.txt's content in
# mnml-zig's own chrome: the caps header, the tab strip, the filter pill,
# the reference's columns, the ▌ marker, the hint row from the keymap.
# The fake server takes port 0 and writes the URL it got to `bb.url`;
# `BITBUCKET_BASE_URL=@<file>` is how the pane reads it, so nothing here
# ever picks a port. `--lifetime-secs` means a run that fails half way
# still leaves nothing behind.
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --lifetime-secs 180 >/dev/null 2>&1 &
# The private config, the reference's keys by name: the three
# workspace-wide tabs over the two repos, no auto-refresh, a bucket of
# its own so the corpus never waits.
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs }, .{ .name = \"Merged\", .kind = .workspace_merged_prs }, .{ .name = \"Pipelines\", .kind = .workspace_pipelines } } }"
# Install the PRs chip from a private folder — the marketplace
# `local_folder` path. The binary is the one `zig build` put beside mnml.
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket: open + merged pull requests across the workspace\", .chip = .{ .glyph = \"\u{f00a8}\", .fallback = \"BP\", .color = \"blue\", .in_palette_bar = false }, .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" }, .{ .id = \"bitbucket_prs.open_mine\", .title = \"Bitbucket PRs: open (mine only)\", .args = .{ \"--only\", \"prs-mine\" } } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket_prs"
command integrations.show_installed
# A manifest copied in by hand carries no `.sdk` stamp (only a binary's
# own `--install` writes one), so the row wears the stale chip at its
# right edge — which, at the shipped column width, is where the version
# was. No folder here builds it, so the chip reads `old SDK`, not a
# `rebuild` that could not run.
expect screen contains "Bitbucket PRs old SDK"
expect screen contains "bitbucket_prs.open"

# The pane mounts on the PR family — two tabs, the strip — resolves
# the account and paints the open tree with both repos opened, the way
# the reference's first fetch does.
# The corpus lays its screens out at full width: the pane opens as a tab,
# not beside whatever the install left active (`integrations.open_as`).
command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
wait 1500
expect screen contains "BITBUCKET PRS"
# The tab carries the manifest's label and its chip glyph — not the
# lower-case `bitbucket · PRs` the pane used to send itself.
expect pane "Bitbucket PRs"
expect screen contains "󰂨 Bitbucket PR"
expect screen contains "(2 repos · 3 PRs)"
expect screen contains " 1 Open + Draft (3)"
expect screen contains " 2 Merged (2)"
expect screen lacks "Pipelines"
expect screen contains "/ filter"
expect screen contains "REPO / #PR"
expect screen contains "AUTHOR"
expect screen contains "UPDATED"
expect screen contains "TITLE"
# The rows fold with the tree's chevron — the toolkit's glyph, the one
# the host's file tree and the tracker pane's tree wear.
expect screen contains "▌  api"
expect screen contains "2 PRs"
expect screen contains "#1234"
expect screen contains "Fix the login redir"
expect screen contains "bug/fix-login"
expect screen contains "  web"
expect screen contains "#820"
expect screen contains "Redesign the em"
expect screen contains "Show more (1)"
# The web bar's chips, as a toolbar row under the strip
# (integrations_bitbucket_filters.test drives them).
expect screen contains " status: Open + Draft "
expect screen contains " author: all "
expect screen contains " target: any "
expect screen contains " show: all"
expect screen contains "Open + Draft · 2 repos, 3 PRs"
expect screen contains "Enter expand"
expect screen contains "q quit"

# api's `Show more (1)` is the row under api's #1234 — not after web —
# and pressing it lifts api's 24-hour window: the day-old #1198 appears.
key g
key j
key j
key enter
expect screen contains "#1198"
expect screen contains "Bump the client"
expect screen lacks "Show more ("
# c collapses every repo (the header keeps its preview), e opens them.
key c
expect screen lacks "Fix the login redir"
expect screen contains "  api"
key e
expect screen contains "Fix the login redir"

# The filter narrows the PR rows under the headers; esc clears it.
type /
type empty
key enter
expect screen contains "Redesign the em"
expect screen lacks "Fix the login redir"
key esc
expect screen contains "Fix the login redir"

# The detail beside the list: the reference's header lines, the
# description, the comments most-recent first.
key g
key j
key d
wait 800
expect screen contains "acme/api#1234"
expect screen contains "OPEN · bug/fix-login → main"
expect screen contains "author: Max Orr"
expect screen contains "○ not approved · 1 total"
expect screen contains "Fixes ENG-4210"
expect screen contains "comments (3, most-recent first):"
expect screen contains "Good point, pushed an escape."
# a approves on the fake server and the detail follows; a again withdraws.
key a
wait 800
expect screen contains "approved acme/api#1234"
expect screen contains "✓ you approved · 2 total"
key a
wait 800
expect screen contains "unapproved acme/api#1234"
expect screen contains "○ not approved · 1 total"
key d

# m is the reference's open↔merged toggle; a merged PR folds out to the
# runs on its merge commit, one row per run, in the toolkit's line:
# state, branch, age, number.
key m
expect screen contains " 2 Merged (2)"
expect screen contains "MERGED"
expect screen contains "#1100"
expect screen contains "Drop the legacy"
key j
key enter
wait 800
expect screen contains "✓ SUCCESSFUL · main · "
expect screen contains "· #412"

# Back to Open, and the show chip: `A` walks all → reviewing →
# awaiting me, what is waiting on MY review. It narrows rows that are
# already loaded, so it costs no request, and it lifts the 24-hour
# window the tree folds old rows behind.
key 1
wait 400
expect screen contains " show: all"
key shift+a
key shift+a
wait 400
expect screen contains " show: awaiting me (1)"
expect screen contains "(1 of 3)"
expect screen contains "#1198"
expect screen lacks "Fix the login redir"
key shift+a
wait 400
expect screen contains "Fix the login redir"

# The key sheet is the one keymap table, in the family's one sheet
# (the Jira pane opens the same): the keys that apply here, Esc closes
# it and a stray key does not.
type ?
expect screen contains " Keys "
expect screen contains "hide this repo (persists)"
expect screen contains "cycle the scope"
expect screen contains "the pull request's detail"
expect screen contains "j/k scroll · Esc close"
key z
expect screen contains " Keys "
key esc
expect screen lacks " Keys "

# x hides a repo and rewrites the config; H brings it back.
key 1
key g
key x
wait 800
expect screen contains "hid api (H to un-hide all)"
expect screen lacks " api"
expect file bitbucket.zon contains "hidden_repos"
expect file bitbucket.zon contains "api"
key H
wait 800
expect screen contains "un-hid 1 repo(s)"
# Back in the tree — collapsed, as the reference re-adds it (the open
# set carries over the refetch; api was not in it).
expect screen contains "  api"

# q ends the pane; the exit banner sits under the next key, which closes it.
key q
wait 500
key x
expect screen lacks "BITBUCKET PRS"

# The corpus shares one data root: leave it as it was found, or the
# INTEGRATIONS rows every later script counts are this one's too.
command integrations.show_installed
key x
expect screen contains "Remove integration"
expect screen contains "bitbucket_prs"
key enter
expect screen contains "Remove Bitbucket PRs?"
key r
expect screen contains "removed bitbucket_prs"
expect screen lacks "Bitbucket PRs"
