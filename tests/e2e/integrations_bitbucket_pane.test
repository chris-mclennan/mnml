# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: BITBUCKET_ACCESS_TOKEN=corpus-write-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
# The Bitbucket integration driven as a real mounted pane, against the
# deterministic Bitbucket in integrations/bitbucket/tools/fake_bitbucket.
# The fake server takes port 0 and writes the URL it got to `bb.url`;
# `BITBUCKET_BASE_URL=@<file>` is how the pane reads it, so nothing here
# ever picks a port. `--lifetime-secs` means a run that fails half way
# still leaves nothing behind.
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --lifetime-secs 120 >/dev/null 2>&1 &
# The private config: a review-queue tab and a per-repo tab, pointed at
# the fake workspace. No token in here — those are in the environment.
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .rate = .{ .min_interval_ms = 0 }, .tabs = .{ .{ .name = \"Review\", .mode = .reviewing }, .{ .name = \"api\", .mode = .repo, .repo = \"api\" } } }"
# Install it from a private folder — the marketplace `local_folder` path
# the Zig integrations plan describes. The binary is the one `zig build`
# put beside mnml.
write market/bitbucket.zon ".{ .id = \"bitbucket\", .label = \"Bitbucket\", .version = \"0.1.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .description = \"Bitbucket Cloud pull requests\", .commands = .{ .{ .id = \"bitbucket.open\", .title = \"Bitbucket: pull requests\" } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket"
command integrations.show_installed
expect screen contains "Bitbucket  0.1.0"
expect screen contains "bitbucket.open"

# The pane mounts, resolves the account over /2.0/user and lists the
# review queue: one pull request, opened by someone else, waiting on me.
command bitbucket.open
command view.focus_pane
wait 1200
expect screen contains "▸1 Review"
expect screen contains "2 api"
expect screen contains "#1198"
expect screen contains "Bump the cl"
expect screen lacks "Fix the log"

# The second tab is one repo's list: both of its open pull requests,
# newest first, with the state and the branches.
key 2
wait 600
expect screen contains "#1234"
expect screen contains "Fix the log"
expect screen contains "OPEN"

# The filter narrows across every column and esc puts it back.
key /
type login
expect screen contains "(1/2)"
expect screen lacks "Bump the cl"
key enter
key esc
expect screen contains "Bump the cl"

# The detail: the reviewers with their votes, the build statuses, the
# diffstat, the diff, the threads, and the Jira key from the body.
key d
wait 900
expect screen contains "acme/api#1234"
expect screen contains "chris/fix-login → main"
expect screen contains "reviewers"
expect screen contains "Dana R"
expect screen contains "changes requested"
expect screen contains "builds"
expect screen contains "Pipeline #412"
expect screen contains "Deploy to dev"
expect screen contains "files (2)"
expect screen contains "src/auth/session.zig"
expect screen contains "issues: [1] ENG-4210"
expect screen contains "@@ -40,7 +40,9 @@"
# The diff is the longest section by far; D folds it away, and the
# threads come into view — an inline comment with the file and line it
# hangs off, and its reply indented under it rather than filed by time.
key D
expect screen contains "diff  (hidden"
expect screen contains "activity"
expect screen contains "withQuery needs"
expect screen contains "src/auth/session.zig:44"
key D
key d

# A write is confirmed first. Escape changes nothing; `y` goes through
# on the write token and the pane says what it did.
key a
expect screen contains "Approve acme/api#1234?"
expect screen contains "y confirm · esc cancel"
key esc
expect screen lacks "Approve acme/api#1234?"
key a
key y
wait 900
expect screen contains "approved acme/api#1234"

# A comment is typed into a real text field — the caret moves, and what
# lands on the server is what was typed.
key c
expect screen contains "enter post · esc cancel"
type ship
key left
key left
key backspace
key end
type ped
key enter
wait 900
expect screen contains "commented on acme/api#1234"

# The merge confirm names the strategy, and `s` cycles it.
key s
expect screen contains "merge strategy: merge commit"
key m
expect screen contains "Merge acme/api#1234"
expect screen contains "strategy: merge commit"
key y
wait 900
expect screen contains "merged acme/api#1234"

# Checking the branch out is refused: the corpus workspace is not a
# clone of acme/api, and the pane says so instead of touching it.
key C
expect screen contains "cannot check out"

# `?` is the key help; any key closes it. `q` ends the pane.
key ?
expect screen contains "check the branch out in the workspace"
key j
expect screen lacks "check the branch out in the workspace"
key q
wait 500
key x
expect screen lacks "acme/api#"

# Uninstall, so the size sweep starts from a clean data root.
command integrations.show_installed
key x
expect screen contains "Remove Bitbucket?"
key r
expect screen contains "removed bitbucket"
