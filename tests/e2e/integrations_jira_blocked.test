# The Jira pane with nothing to show: no config, then a config with no
# token. Both paint a screen that names the file and the next step —
# neither is a blank pane, and neither needs the network.
#
# The manifest is written straight into the workspace's own
# `.mnml/integrations/`, which is the per-project install path; the
# trust gate is not in the way because the e2e workspace is trusted.
# env: JIRA_API_TOKEN=
# env: MNML_JIRA_CONFIG=
write .mnml/integrations/jira.zon ".{ .id = \"jira\", .label = \"Jira\", .version = \"0.1.0\", .binary = \"$MNML_JIRA\", .commands = .{ .{ .id = \"jira.open\", .title = \"Jira: tickets\" } } }"
command integrations.refresh
command jira.open
command view.toggle_tree
command view.focus_pane
expect screen contains "No Jira config yet."
expect screen contains "--write-config"
expect screen contains ".jira.url"
key q
wait 300
key x
# Now a config, but still no token: the pane says where a token comes
# from and where to put it, and never guesses one.
write .mnml/integrations/jira/config.zon ".{ .jira = .{ .url = \"http://127.0.0.1:18720\", .email = \"fake@acme.com\" }, .tabs = .{ .{ .name = \"Mine\", .kind = .work_assigned } } }"
command jira.open
command view.focus_pane
# `# env: JIRA_API_TOKEN=` sets it to the empty string, which is its own
# reason: the user meant to set it and the shell ate the value.
expect screen contains "set to the empty string"
expect screen contains "id.atlassian.com"
expect screen contains "JIRA_API_TOKEN"
expect screen contains "press r to try again"
expect screen lacks "KEY"
key q
wait 300
key x
# And a config that does not parse says so, with the file named.
write .mnml/integrations/jira/config.zon ".{ .jira = .{ .url = "
command jira.open
command view.focus_pane
expect screen contains "The config did not parse."
expect screen contains "config.zon"
key q
