# width: 120
# The same split by its other doors. `view.split_right` / `split_down`
# are what the strip's buttons, the palette, `:vs` / `:sp` and vim's
# Ctrl-W v / s all run — `split_preview_tab.test` and
# `split_md_preview.test` take the buttons; this script takes the
# palette and the vim chord on a glanced editor, and then a preview
# tab DRAGGED into a split, which the drag itself keeps (`dispatch.zig`:
# dragging a tab is commitment) before `splitWith` is handed the pane
# and leaves it as it came. Ctrl-W on a RENDERED markdown tab is not
# routed to the vim prong at all (the `v` lands as VISUAL) — a separate
# gap, so the chord here is pressed on an editor.
write a.txt "alpha alpha"
write b.txt "beta beta"
write README.md "# hi\nsecond line\n"
command tree.refresh

# Rows: the workspace header 1, a.txt 2, b.txt 3, README.md 4. A
# glance, then the palette's split down: two kept a.txt tabs, the file
# in both halves.
click 14 2
expect pane "a.txt"
expect status contains "\"panes\":[{\"title\":\"a.txt\",\"dirty\":false,\"preview\":true}]"
key ctrl+shift+p
expect screen contains "┌ Command palette "
type view.split_down
key enter
expect screen lacks "┌ Command palette "
expect pane "a.txt"
expect screen contains "alpha alpha"
expect status contains "\"panes\":[{\"title\":\"a.txt\",\"dirty\":false,\"preview\":false},{\"title\":\"a.txt\",\"dirty\":false,\"preview\":false}]"
command view.close_split
expect pane "a.txt"

# vim's Ctrl-W v on a glanced editor runs the same command: the glance
# is kept, its twin beside it.
click 14 3
expect pane "b.txt"
expect status contains "{\"title\":\"b.txt\",\"dirty\":false,\"preview\":true}"
command editor.use_vim
key ctrl+w
key v
expect pane "b.txt"
expect screen contains "beta beta"
expect status contains "{\"title\":\"b.txt\",\"dirty\":false,\"preview\":false},{\"title\":\"b.txt\",\"dirty\":false,\"preview\":false}"
expect status lacks "\"preview\":true"
command view.close_split
command editor.use_standard

# A rendered glance dragged from its chip (the third in the strip, from
# column 55) into the pane's right edge: it lands kept in its own half,
# the two editors' strip on the left ending in the `+` (the narrower
# leaf drops b.txt's close glyph).
click 14 4
expect pane "README.md"
expect screen contains "second line"
expect status contains "{\"title\":\"README.md\",\"dirty\":false,\"preview\":true}"
drag 62 1 112 15
expect screen contains "second line"
expect screen contains "b.txt 󰐕"
expect status contains "{\"title\":\"README.md\",\"dirty\":false,\"preview\":false}"
expect status lacks "\"preview\":true"
