# `[editor] wheel_moves_cursor = always` in standard mode: the cursor
# rides the wheel (vim's Ctrl-E canon) instead of the view pinning
# under a resting cursor. Five notches × 3 lines: `Ln 16/50`. Then
# `never` under vim: the view moves, the cursor stays on line 16.
ex set editor.wheel_moves_cursor=always
write long.txt "W01\nW02\nW03\nW04\nW05\nW06\nW07\nW08\nW09\nW10\nW11\nW12\nW13\nW14\nW15\nW16\nW17\nW18\nW19\nW20\nW21\nW22\nW23\nW24\nW25\nW26\nW27\nW28\nW29\nW30\nW31\nW32\nW33\nW34\nW35\nW36\nW37\nW38\nW39\nW40\nW41\nW42\nW43\nW44\nW45\nW46\nW47\nW48\nW49\nW50\n"
open long.txt
command view.toggle_tree
expect screen contains "Ln 1/50"
scroll 40 20 down
scroll 40 20 down
scroll 40 20 down
scroll 40 20 down
scroll 40 20 down
expect screen contains "Ln 16/50"
ex set editor.wheel_moves_cursor=never
command editor.use_vim
scroll 40 20 down
scroll 40 20 down
expect screen contains "Ln 16/50"
expect screen lacks "W01"
