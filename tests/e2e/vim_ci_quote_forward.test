# `ci"` with the cursor before the first quote on the line uses the first
# quoted string after it (`:help i"`); `di"` / `yi"` the same.
write a.txt "name = \"world\";\nx = 'a' + 'b';\n"
open a.txt
command editor.use_vim

type 0ci"X
key esc
command file.save
expect file a.txt contains "name = \"X\";\n"
type j0di'
command file.save
expect file a.txt contains "x = '' + 'b';\n"
# From the `+`, between two strings, the nearest quote behind the cursor
# opens the string (Neovim's `current_quote`): `yi'` yanks ` + `, the
# text between the two quoted strings, not the `b` after it. Neovim
# 0.12.5 --clean, `0f+yi'$p` on this line → `x = '' + 'b'; + `.
type 0f+yi'$p
command file.save
expect file a.txt contains "x = '' + 'b'; + \n"
