# width: 80
# height: 24
# env: PATH=
# Twelve tabs at 80 columns overflow the strip: the pager ` ‹ n/m › `
# (`ui/stepper.zig`) stands where the tabs end, says which page of
# whole tabs is on show, and its arrows turn a page — `›` past the last
# page wraps to the first, `‹` before the first to the last. The ` ⋯ `
# after it (the buffer picker, `tab_strip_picker_chip.test`) takes its
# three cells, so a page holds three tabs here. Closing tabs until all
# fit takes the pager and its ` ⋯ ` away entirely.
write t1.txt "t1\n"
write t2.txt "t2\n"
write t3.txt "t3\n"
write t4.txt "t4\n"
write t5.txt "t5\n"
write t6.txt "t6\n"
write t7.txt "t7\n"
write t8.txt "t8\n"
write t9.txt "t9\n"
write t10.txt "t10\n"
write t11.txt "t11\n"
write t12.txt "t12\n"
open t1.txt
open t2.txt
open t3.txt
open t4.txt
open t5.txt
open t6.txt
open t7.txt
open t8.txt
open t9.txt
open t10.txt
open t11.txt
open t12.txt
# The last tab is active: the last page of four, the pager at the end.
expect screen contains "t12.txt 󰅖   󰐕"
expect screen contains "‹ 4/4 ›  ⋯"
expect screen lacks "t1.txt"
# `›` (columns 62-64) past the last page: the first, from t1.
click 63 1
expect screen contains "‹ 1/4 ›"
expect screen contains " t1.txt 󰅖"
expect screen lacks "t12.txt"
# A page is whole tabs: page 1's last, t4, wears its close button, and
# the next one does not start, cut, before the 󰐕.
expect screen contains "t4.txt 󰅖   󰐕"
expect screen lacks "t5"
# `›` again: page 2; `‹` (56-58) back to 1; `‹` before the first: the last.
click 63 1
expect screen contains "‹ 2/4 ›"
expect screen lacks " t1.txt 󰅖"
click 57 1
expect screen contains "‹ 1/4 ›"
click 57 1
expect screen contains "‹ 4/4 ›"
expect screen contains "t12.txt"
# The keys never moved: t12 is still the tab being typed into.
expect pane t12.txt
# Close tabs until every one fits: the pager is gone, cells and all.
command buffer.close
command buffer.close
command buffer.close
command buffer.close
command buffer.close
command buffer.close
command buffer.close
expect screen contains "t5.txt"
expect screen lacks "‹"
expect screen lacks "›"
expect screen lacks "⋯  󲀀"
