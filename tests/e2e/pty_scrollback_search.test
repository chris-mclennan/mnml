# Search in a terminal pane's scrollback — the half of "find in a
# terminal" that a selection alone does not give. `/` in vim's
# terminal-normal mode opens the editor's own find bar (same look, the
# same `.*` and `Aa` chips) over the pane's LAST ROW, so the child keeps
# its size, and it searches everything the terminal still holds, the
# scrollback and the screen. The matches wear the theme's `match` role,
# the current one `current_match` — onedark's #42464e and #e7c787
# grounds — and the bar counts `match k/N`.
#
# A 3000-line log: `/2999` finds the one line. Its row is 35 (row 0 is
# the menu bar, 1 the tab strip, the pane's rail is column 0).
write a.txt "\n"
command view.toggle_tree
command editor.use_vim
ex term seq 1 3000; sleep 30
wait 1500
expect screen contains "▌3000"
key ctrl+x
type "/2999"
expect screen contains "match 1/1"
expect screen contains "▌2999"
expect color 1 35 bg #e7c787
expect color 1 34 bg #1e222a
# Enter lands and closes, as vim's `/` does, and toasts `match 1/1` —
# Esc clears the toast, which would otherwise sit over the next bar's
# count.
key enter
expect screen lacks " Find "
key esc
expect screen lacks "match 1/1"

# A regex with two matches — 2998 and 2999. `/` searches down from the
# cursor's line (the bottom), Neovim's way, so it wraps to the first,
# 2998; `n` goes on down to 2999, `N` comes back.
type "/"
key ctrl+r
type "^299[89]$"
expect screen contains "match 1/2"
expect color 1 34 bg #e7c787
expect color 1 35 bg #42464e
key enter
expect screen lacks " Find "
type "n"
expect screen contains "match 2/2"
expect color 1 34 bg #42464e
expect color 1 35 bg #e7c787
# With the bar closed, `n` / `N` carry the terminal's selection with the
# current match: `N` back to 2998, then `y` yanks it (the terminal's
# copy) and `p` in an editor puts it.
type "N"
expect color 1 34 bg #e7c787
key y
expect screen contains "copied the selection"
open a.txt
type "p"
ex w
expect file a.txt contains "2998"
