# env: HOME=home
# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# env: ACME_SITE=https://tracker.example.com
# A ticket key and a pull-request ref link in a terminal pane too. The
# stand-in "acme" launcher declares a ticket key and the forms the
# Bitbucket integration's `--install` writes for a workspace `acme`:
# `<repo>#<n>` and `acme/<repo>#<n>`. Core knows none of them.
write bin/claude #!/bin/bash\nprintf 'fix ENG-123 in acme/widget#42 now\\n'\nexec sleep 600
shell chmod +x bin/claude
write acme.zon ".{ .id = \"acme\", .label = \"Acme\", .commands = .{ .{ .id = \"acme.hello\", .title = \"Acme: hello\", .run = \":echo hi\" } }, .auth = .{ .{ .key = \"site_url\", .label = \"Site\", .kind = .url, .env_fallback = \"ACME_SITE\" } }, .links = .{ .{ .pattern = \"[A-Z][A-Z0-9]+-[0-9]+\", .url = \"{site_url}/browse/{0}\" }, .{ .pattern = \"(?<![/\\\\w.-])(acme)/([A-Za-z0-9_.-]+)#([0-9]+)\", .url = \"https://bitbucket.org/{1}/{2}/pull-requests/{3}\" }, .{ .pattern = \"(?<![/\\\\w.-])([A-Za-z0-9_.-]+)#([0-9]+)\", .url = \"https://bitbucket.org/acme/{1}/pull-requests/{2}\" } } }"
shell mkdir -p "$MNML_DATA_ROOT/integrations" && cp acme.zon "$MNML_DATA_ROOT/integrations/acme.zon"
command integrations.refresh
command ai.claude_code_new
expect within 5000 screen contains "fix ENG-123 in acme/widget#42 now"
# The pane's line is on row 2: `ENG-123` at columns 36..42,
# `acme/widget#42` at 47..60. A line links once it has held still.
wait 200
# At rest a link keeps its colours (a dotted underline is the cue).
expect color 38 2 fg not #61afef
expect color 50 2 fg not #61afef
# Under the pointer the PR ref takes the accent, whole, and nothing past it.
hover 50 2
expect color 47 2 fg #61afef
expect color 60 2 fg #61afef
expect color 61 2 fg not #61afef
expect color 38 2 fg not #61afef
hover 38 2
expect color 36 2 fg #61afef
expect color 42 2 fg #61afef
expect color 43 2 fg not #61afef
# Right-click on the key: the Link menu; Open link goes through the
# app's opener (the runner's MNML_OPEN_URL logs it).
rightclick 38 2
expect screen contains "Copy link"
key down
key enter
expect file opened-urls.log contains "https://tracker.example.com/browse/ENG-123"
# The PR ref, the same way, to the pull request in the workspace.
rightclick 50 2
expect screen contains "Open link"
key down
key enter
expect file opened-urls.log contains "https://bitbucket.org/acme/widget/pull-requests/42"
# Copy link puts the address on the clipboard.
rightclick 50 2
key enter
expect screen contains "link copied"
