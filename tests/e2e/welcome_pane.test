# width: 120
# The welcome pane's minimal form (src/ui/welcome.zig, `ui.welcome =
# minimal`), reached through its Settings row: the editor area with no
# pane open is the logo, `workspace · <name>`, the shortcut list and
# the version. On a workspace outside a repository the stack is
# eighteen rows from row 11. A press on a shortcut row runs its
# command. The start surface is the default (welcome_start.test).
write a.txt "hello from a\n"
write b.txt "b\n"
expect screen contains "RECENT FILES"
command view.settings
type Welcome screen
key enter
key right
key enter
expect screen contains "workspace ·"
expect screen contains "^P     find file"
expect screen contains "^Q     quit"
expect screen lacks "RECENT FILES"
expect screen contains "b.txt"
# `  ^B     toggle tree` is 20 cells on the 89-cell pane: inset 34, so
# it starts at column 65 of row 25.
click 67 25
expect screen lacks "b.txt"
# The pane is the full 120 columns now: the row starts at column 50.
click 52 25
expect screen contains "b.txt"
open a.txt
expect screen contains "1 hello from a"
command buffer.close
expect screen lacks "1 hello from a"
expect screen contains "^P     find file"
