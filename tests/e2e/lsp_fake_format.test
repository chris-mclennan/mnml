# Formatting through the fake server: the whole-document edit trims the
# blanks after `let x = 1;`; the buffer is the server's text and the
# save writes it.
write src/main.fk "fn foo() {\n  let x = 1;  \n  foo(x); // TODO later\n}\nfn bar() { foo(); }\n"
write .fkroot ""
write .mnml/config.zon .{ .lsp = .{ .fake = .{ .cmd = "$MNML_FAKE_LSP", .args = .{ "--log", "lsp.log" }, .extensions = .{ "fk" }, .root_markers = .{ ".fkroot" } } } }
open src/main.fk
expect screen contains "LSP 1"
expect screen contains "72B"
command lsp.format
expect screen contains "formatted src/main.fk"
expect screen contains "70B"
key ctrl+s
expect file src/main.fk lacks "let x = 1;  "
expect file src/main.fk contains "let x = 1;\n  foo"
