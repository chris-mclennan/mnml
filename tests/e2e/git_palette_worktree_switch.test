# Two linked worktrees beside the main tree (src/app/git_palette.zig
# `openWorktree`): a double-click on the SECOND switches the graph tab
# to that worktree — the tab strip shows its name, the pill reads it,
# the palette lists its checked-out branch — not to its neighbour above;
# one click switches nothing. Rows at 120x40: LOCAL 7, feat-a 8, feat-b
# 9, main 10, gap 11, REMOTE 12, gap 13, WORKTREES 14, main (the
# workspace) 15, feat-a (wt-a) 16, feat-b (wt-b) 17.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write .gitignore ".mnml/\nwt-a/\nwt-b/\n"
write a.txt "one\n"
shell git add .gitignore a.txt
shell git commit -q -m "init"
shell git worktree add -q wt-a -b feat-a
shell git worktree add -q wt-b -b feat-b
command view.activity_git
wait 1000
expect screen contains " 󰐅 WORKTREES"
expect screen contains "󰋜 main"
expect screen contains "  󰐅 feat-a (wt-a)"
expect screen contains "  󰐅 feat-b (wt-b)"
expect screen contains "󱓏 main"
# One click on wt-b's row: no tab, no switch.
click 6 17
wait 600
expect screen lacks "󰊢 wt-b"
expect screen lacks " wt-b 󰅀"
expect screen contains "󱓏 main"
# The double-click: wt-b's tab, wt-b in the pill, its branch checked out
# in LOCAL — and not wt-a's.
doubleclick 6 17
wait 1500
expect screen contains "󰊢 wt-b "
expect screen contains " wt-b 󰅀"
expect screen contains "󱓏 feat-b"
expect screen lacks " wt-a 󰅀"
