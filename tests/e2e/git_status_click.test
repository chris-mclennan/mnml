# The git status pane's hits: a click on a row moves the cursor, a click
# on the `s` hint word stages the cursor's file, `u` unstages it. The
# pane starts at column 31: the hint row is y 3 (`s` at x 33, `u` at
# x 35), the entries are y 5 and y 6.
shell git init -q -b main
shell git config user.email "test@mnml.dev"
shell git config user.name "mnml test"
write seed.txt "seed\n"
shell git add seed.txt
shell git commit -q -m "initial"
write a.txt "a\n"
write b.txt "b\n"
command git.status_pane
wait 800
expect screen contains "▶ ? a.txt"
click 40 6
expect screen contains "▶ ? b.txt"
expect screen lacks "▶ ? a.txt"
click 33 3
wait 1500
expect screen contains "staged b.txt"
expect screen contains "Staged changes (1)"
expect screen contains "Unstaged changes (1)"
# The cursor keeps its flat index, which is now the staged row (y 8:
# Unstaged header, a.txt, blank, Staged header, b.txt).
expect screen contains "▶ A b.txt"
click 40 5
expect screen contains "▶ ? a.txt"
# `u` on an unstaged row only says so.
click 35 3
wait 300
expect screen contains "not staged"
click 40 8
expect screen contains "▶ A b.txt"
click 35 3
wait 1500
expect screen contains "unstaged b.txt"
expect screen contains "Unstaged changes (2)"
