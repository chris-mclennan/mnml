# A glance at a markdown file takes over the last glanced-at markdown
# tab instead of adding one; typing swaps the raw editor in, and that
# editor stays when the next glance opens beside it.
write a.md "# Alpha\n\nfirst\n"
write b.md "# Bravo\n\nsecond\n"
write c.md "# Charlie\n\nthird\n"
open a.md
expect screen contains "first"
open b.md
expect screen contains "second"
expect screen lacks " a.md "
key Z
expect screen contains "Z# Bravo"
open c.md
expect screen contains "third"
expect screen contains " b.md "
expect screen contains " c.md "
