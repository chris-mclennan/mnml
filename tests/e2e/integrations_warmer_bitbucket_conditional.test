# The warmer, on the forge pane: the pane opens on the tab somebody is
# looking at, every GET that has the server's tag goes out conditional,
# and the listing says how old it is.
#
# The assertions are on the wire, off the fake's `--log-file`: a 304 is
# the whole mechanism, and nothing on screen can show one.
# env: MNML_MARKETPLACE_LOCAL=market
# env: MNML_BITBUCKET_CONFIG=${MNML_E2E_WORKSPACE}/bitbucket.zon
# env: BITBUCKET_BASE_URL=@${MNML_E2E_WORKSPACE}/bb.url
# env: BITBUCKET_RATELIMIT_STATE=${MNML_E2E_WORKSPACE}/bucket.json
# env: BITBUCKET_API_TOKEN=corpus-read-token
# env: MNML_WORKSPACE=${MNML_E2E_WORKSPACE}
shell "$MNML_FAKE_BITBUCKET" --port 0 --url-file bb.url --life-secs 180 --log-file wire.jsonl >/dev/null 2>&1 &
write bitbucket.zon ".{ .email = \"me@example.com\", .workspace = \"acme\", .repos = .{ \"api\", \"web\" }, .refresh_interval_secs = 0, .rate = .{ .rate_per_sec = 1000, .capacity = 1000 }, .tabs = .{ .{ .name = \"Open + Draft\", .kind = .workspace_open_prs }, .{ .name = \"Merged\", .kind = .workspace_merged_prs } } }"
write market/bitbucket_prs.zon ".{ .id = \"bitbucket_prs\", .label = \"Bitbucket PRs\", .version = \"0.2.0\", .binary = \"$MNML_BITBUCKET_INTEGRATION\", .args = .{ \"--only\", \"prs\" }, .description = \"Bitbucket: open + merged pull requests across the workspace\", .chip = .{ .glyph = \"\u{f00a8}\", .fallback = \"BP\", .color = \"blue\", .in_palette_bar = false }, .commands = .{ .{ .id = \"bitbucket_prs.open\", .title = \"Bitbucket PRs: open\" } } }"
command integrations.show_marketplace
expect screen contains "Mkt (1)"
key i
expect screen contains "installed bitbucket_prs"

command integrations.open_as_tab
command bitbucket_prs.open
command view.toggle_tree
command view.focus_pane
wait 4000
expect screen contains "BITBUCKET PRS"
expect screen contains "(2 repos · 3 PRs)"
# The listing says how old it is, in the same words the tracker pane
# uses.
expect screen contains "as of "
# A cold start has nothing held, so nothing was answered 304.
expect file wire.jsonl contains "pullrequests"
expect file wire.jsonl lacks "\"status\":304"

# `r` over the same rows: every GET now carries the tag the server gave
# it, and the server says there is nothing new. A round trip that costs
# a token and no bytes.
shell : > wire.jsonl
key r
wait 4000
expect file wire.jsonl contains "\"status\":304"
expect screen contains "BITBUCKET PRS"

# `R` asks outright, so a tag that has somehow gone wrong is always one
# keypress from being replaced. The listing comes back whole.
shell : > wire.jsonl
key shift+r
wait 4000
expect file wire.jsonl contains "\"status\":200"

key q
wait 500
