# env: HOME=home
# env: PATH=${MNML_E2E_WORKSPACE}/bin:${PATH}
# Vim `]a` / `[a` from a session pane's terminal-normal mode (T-NORMAL)
# step the session ring as they do from an editor's normal mode, with a
# count; in TERMINAL they still reach the child.
write bin/claude #!/bin/bash\nn=$(cat .n 2>/dev/null || echo 0); n=$((n+1)); echo $n > .n\nprintf '\\033]0;claude %s\\007' $n\nprintf 'fake claude %s\\n' $n\nexec sleep 600
write bin/codex #!/bin/bash\nprintf '\\033]0;codex one\\007'\nprintf 'fake codex\\n'\nexec sleep 600
shell chmod +x bin/claude bin/codex
write a.txt "alpha alpha"
open a.txt
command editor.use_vim
command ai.claude_code_new_right
wait 400
command ai.codex_new_tab
wait 400
command ai.claude_code_new_page
wait 400
expect screen contains "‹ 3/3 ›"
# Back to the second session, then T-NORMAL and `]a`: on to the third.
command ai.focus_prev_session
wait 200
expect pane codex one
key ctrl+x
expect screen contains "T-NORMAL"
key ]
key a
wait 200
expect pane claude 2
expect screen contains "3/3 ›"
# `2[a` from T-NORMAL: two back, to the first.
key ctrl+x
key 2
key [
key a
wait 200
expect pane claude 1
expect screen contains "1/3 ›"
