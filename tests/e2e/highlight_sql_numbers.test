# width: 160
# height: 40
# env: PATH=
# SQL numbers paint as constants, not strings: tree-sitter-sequel's query
# matches them with a Lua `%d` class under `#match?`, read as the Lua
# pattern it is.
write q.sql "SELECT 42, 2.5, 'x';\n"
open q.sql
wait 300
expect screen contains "SELECT 42, 2.5, 'x';"
expect color 45 2 fg #d19a66
expect color 49 2 fg #d19a66
expect color 54 2 fg #98c379
