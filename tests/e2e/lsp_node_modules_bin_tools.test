# A JS/TS project's prettier and eslint live in its node_modules/.bin
# (eslint 9's own setup installs them there; nothing global need exist).
# mnml looked the builtin tools up on PATH only: with the project's
# `.prettierrc` and its own prettier, `lsp.format` ran the language
# server's formatter, and the lint toasted "FileNotFound". The tools are
# now looked for in node_modules/.bin beside the file and above it, up to
# the workspace root, before PATH (npm's rule; conform.nvim and
# nvim-lint do the same). Both tools here are shims with recognisable
# output; the file sits two directories below the node_modules.
write node_modules/.bin/prettier #!/bin/sh\ncat > /dev/null\nprintf 'const x = 1 // local prettier\\n'\n
write node_modules/.bin/eslint #!/bin/sh\nfor a; do f=$a; done\nprintf '[{"filePath":"%s/%s","messages":[{"ruleId":"prefer-const","severity":2,"message":"local eslint","line":1,"column":7}]}]' "$PWD" "$f"\n
shell /bin/chmod +x node_modules/.bin/prettier node_modules/.bin/eslint
write .prettierrc { "semi": false, "singleQuote": true }\n
write package.json { "name": "acme", "devDependencies": { "prettier": "^3", "eslint": "^9" } }\n
write .fkroot ""
write .mnml/config.zon .{ .lsp = .{ .fake = .{ .cmd = "$MNML_FAKE_LSP", .extensions = .{ "js" }, .root_markers = .{ ".fkroot" } } } }
write src/deep/a.js "const  x=1;  \n"
open src/deep/a.js
expect within 5000 screen contains "LSP 1"
command lsp.format
expect within 3000 screen contains "with prettier"
expect screen contains "const x = 1 // local prettier"
command file.save
command editor.lint_external
expect within 3000 screen contains "✗1"
command view.toggle_right_panel
command lsp.diagnostics
expect screen contains "local eslint"
