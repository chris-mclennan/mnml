# width: 120
# Each profile's which-key popup is its own: the standard profile's is
# its `Ctrl+K` chords (VS Code's, where VS Code defines one), the vim
# profile's the `<leader>` tree with NvChad's `r → +lsp` and nvim-dap's
# `d → +debug`; `<BS>` climbs back out of a group instead of dismissing
# the popup.
write a.txt "hello\n"
open a.txt

# Standard: Ctrl+K is the leader, the header says so, and the rows are
# the Ctrl+K chords.
command editor.use_standard
command whichkey.leader
expect screen contains "┌ Ctrl+K "
expect screen lacks "┌ <leader> "
expect screen contains "s → save all"
expect screen contains "ctrl+s → cheatsheet (all chords)"
expect screen lacks "f → +find"
expect screen lacks "r → +lsp"
expect screen lacks "d → +debug"
expect screen contains "esc to cancel"
key esc
expect screen lacks "┌ Ctrl+K "

# Vim: space is the leader, and the two NvChad-only rows are there.
command editor.use_vim
key space
wait 700
expect screen contains "┌ <leader> "
expect screen contains "r → +lsp"
expect screen contains "d → +debug"

# A group descends, and Backspace comes back up a level.
key f
expect screen contains "┌ <leader>f  +find (9) "
expect screen contains "grep"
key backspace
expect screen contains "┌ <leader> "
expect screen contains "f → +find"
key esc
expect screen lacks "┌ <leader> "
