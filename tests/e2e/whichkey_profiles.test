# width: 120
# Both profiles open the same popup at the same root, and the root the
# STANDARD profile shows is the reference editor's: no `r → +lsp`
# (NvChad's `<leader>ra`, which that popup does not carry) and no
# `d → +debug`. The vim profile shows both, and `<BS>` climbs back out
# of a group instead of dismissing the popup.
# (The standard profile's Ctrl+K PAUSE lists its own Ctrl+K chords (since
# 2026-09-23 — `standard_ctrl_k_pause_menu.test`); the leader tree is
# `whichkey.leader`, the palette's "Leader menu (which-key)".)
write a.txt "hello\n"
open a.txt

# Standard: Ctrl+K is the leader, and the header says so.
command editor.use_standard
command whichkey.leader
expect screen contains "┌ Ctrl+K "
expect screen lacks "┌ <leader> "
expect screen contains "f → +find"
expect screen contains "l → +lsp"
expect screen lacks "r → +lsp"
expect screen lacks "d → +debug"
expect screen contains "esc to cancel"
key esc
expect screen lacks "┌ Ctrl+K "

# Vim: space is the leader, and the two NvChad-only rows are there.
command editor.use_vim
key space
wait 700
expect screen contains "┌ <leader> "
expect screen contains "r → +lsp"
expect screen contains "d → +debug"

# A group descends, and Backspace comes back up a level.
key f
expect screen contains "┌ <leader>f  +find (8) "
expect screen contains "grep"
key backspace
expect screen contains "┌ <leader> "
expect screen contains "f → +find"
key esc
expect screen lacks "┌ <leader> "
