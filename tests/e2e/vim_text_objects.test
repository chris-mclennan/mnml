# Vim text objects — `diw` deletes the inner word; `daw` includes trailing
# whitespace; same shape for `ciw` / `caw`. Cursor doesn't need to be at the
# start of the word. The bracket and quote objects act on the pair Neovim
# picks, the cursor inside it or not (the cases at the end).
write code.txt "alpha beta gamma"
open code.txt
command editor.use_vim

# Cursor sits on the 'b' of "beta" (col 6 = "alpha "). Use `f` is missing in
# vim coverage; jump via `0` + word-motion `w`.
key 0
key w
# Now cursor is at the start of "beta".
key d
key i
key w
expect screen contains "alpha  gamma"
expect screen lacks "beta"

# Set up "around word" — daw should leave just "alpha gamma" if we start on the
# middle word + trailing space.
write code2.txt "alpha beta gamma"
open code2.txt
command editor.use_vim
key 0
key w
key d
key a
key w
expect screen contains "alpha gamma"
expect screen lacks "beta"

# Quote text objects — di" deletes the contents of a double-quoted string.
write quoted.txt "let s = \"hello world\";"
open quoted.txt
command editor.use_vim
# Move into the string. After `0` cursor is at start; jump to col 10 with `l`s.
key 0
key w
key w
key w
# Cursor is now near the string. Run di".
key d
key i
key "
expect screen contains "let s = \"\";"
expect screen lacks "hello"

# Paragraph text objects — dip deletes a paragraph.
write para.txt "first paragraph\nstill first\n\nsecond paragraph\nstill second\n\nthird"
open para.txt
command editor.use_vim
# Cursor at top, on "first paragraph". dip deletes lines 0-1.
key d
key i
key p
expect screen contains "second paragraph"
expect screen lacks "first paragraph"

# Bracket text objects — di( deletes inside parens.
write parens.txt "call(arg1, arg2)"
open parens.txt
command editor.use_vim
# Move past "call(" — `l` five times places the cursor at 'a' of "arg1".
key 0
key l
key l
key l
key l
key l
key d
key i
key (
expect screen contains "call()"
expect screen lacks "arg1"

# Outside a pair the bracket object is the next pair — Neovim's `i(`
# "If the cursor is not inside a () block, then find the next "("".
# Neovim 0.12.5 --clean on the same text, same keys:
#   ci(X<Esc> from the f of `foo bar(baz) qux`   → foo bar(X) qux
#   fbda[      on `a [1] b [2] c`               → a [1] b  c
write fwd.txt "foo bar(baz) qux"
open fwd.txt
command editor.use_vim
key 0
key c
key i
key (
type X
key esc
expect screen contains "foo bar(X) qux"

write two.txt "a [1] b [2] c"
open two.txt
command editor.use_vim
key 0
key f
key b
key d
key a
key [
expect screen contains "a [1] b  c"

# Quotes pick the string Neovim picks. From the x, di" empties the first
# string after the cursor; between two strings the nearest quote behind
# the cursor opens the string, so fcdi" on `a "b" c "d"` takes ` c `;
# and da" takes the blank after the closing quote with it.
#   di"      on `x = "foo" y`   → x = "" y
#   fcdi"    on `a "b" c "d"`   → a "b""d"
#   da"      on `k "q" y`       → k y
write fwdq.txt "x = \"foo\" y"
open fwdq.txt
command editor.use_vim
key 0
key d
key i
key "
expect screen contains "x = \"\" y"

write between.txt "a \"b\" c \"d\""
open between.txt
command editor.use_vim
key 0
key f
key c
key d
key i
key "
expect screen contains "a \"b\"\"d\""

write around.txt "k \"q\" y"
open around.txt
command editor.use_vim
key 0
key d
key a
key "
expect screen contains "k y"
expect screen lacks "k  y"

# Nothing to find — no `(` anywhere after the cursor — is a no-op that
# leaves Normal mode as it was: Neovim's `di(` on `no pairs here` from
# the p changes nothing, and the next `x` deletes the p.
write none.txt "no pairs here\nsecond"
open none.txt
command editor.use_vim
key 0
key w
key d
key i
key (
expect screen contains "no pairs here"
expect status contains "\"mode\":\"NORMAL\""
key x
expect screen contains "no airs here"
