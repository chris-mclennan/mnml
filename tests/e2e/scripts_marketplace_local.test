# Installed scripts (lua-install): the Marketplace tab pointed at a
# folder of the user's OWN. The curated set that ships with mnml is the
# repo's `lua/` (see scripts_marketplace_default.test); this file covers
# the override — `scripts.marketplace_local` names a folder of script
# directories, read the way a `local_folder` integrations source is, and
# `MNML_SCRIPTS_MARKETPLACE` beats it, which is what this file uses (the
# App's config is read before the `write` steps run). Installing from
# either badges the row `official`.
# env: MNML_SCRIPTS_MARKETPLACE=index
# `MNML_SCRIPTS_ROOT` keeps what this file installs inside its own temp
# workspace, out of the data root the whole corpus shares.
# env: MNML_SCRIPTS_ROOT=installed
shell mkdir -p index/tidy
write index/tidy/script.zon ".{ .name = \"tidy\", .api = 1, .version = \"0.9.0\", .description = \"Tidies things\", .commands = .{ \"user.tidy\" }, .source = .marketplace }\n"
write index/tidy/init.lua "mnml.command{ id = 'tidy', title = 'Tidy', run = function() mnml.toast('tidied') end }\n"
command view.activity_scripts
expect screen contains "SCRIPTS"
expect screen contains "Mkt (1)"
command script.show_marketplace
expect screen contains "tidy"
expect screen contains "0.9.0"
expect screen contains "Tidies things"
# Install it: the same trust dialog, then the command is live.
command script.marketplace_install
expect screen contains "Install this script?"
expect screen contains "tidy 0.9.0"
key i
expect screen contains "scripts: installed tidy"
command user.tidy
expect screen contains "tidied"
command script.show_installed
expect screen contains "tidy"
