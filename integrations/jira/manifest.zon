// The Jira Work manifest — one of the three chips the Jira integration
// ships, each opening the same binary on one family of tabs
// (`--only work`), the way the reference tracker's three launcher
// manifests do. `mnml-jira --install` writes all three into mnml's
// data root; the INTEGRATIONS section's Dev tab reads `manifest.zon`
// beside build.zig to list the folder before anything is built.
.{
    .id = "jira_work",
    .label = "Jira Work",
    .description = "Jira: tickets assigned to me + recently done",
    .version = "0.2.2",
    .binary = "mnml-jira",
    .category = "tracker",
    .chip = .{ .glyph = "\u{f1c19}", .fallback = "JW", .color = "blue", .tooltip = "Jira Work", .in_palette_bar = false }, // MnmlSymbols: Atlassian work-items
    .commands = .{
        .{ .id = "jira_work.open", .title = "Jira Work: open", .args = .{ "--only", "work" }, .keys = .{"space i j w"} },
        .{ .id = "jira_work.refresh", .title = "Jira Work: republish the statusline count", .ex = "term mnml-jira --values --only work --workspace {{workspace}}" },
    },
    .statusline = .{
        .{ .id = "assigned", .text = "\u{f1c19}", .color = "#1B5DCF", .click_command = "jira_work.open", .priority = 60, .tooltip = "Jira: open items assigned to me. Hover after a poll for the breakdown by status." },
        // The second figure: the tab configured as QA Actionable Now.
        // It rests blank — `--values` publishes it only when such a tab
        // exists, so a user without one never sees a zero that means
        // "not set up".
        .{ .id = "qa_actionable", .text = "", .color = "#C678DD", .click_command = "jira_work.open", .priority = 59, .tooltip = "Jira: the tab you have set up as QA Actionable Now." },
    },
    .auth = .{
        .{ .key = "site_url", .label = "Jira site URL", .kind = .url, .required = true, .env_fallback = "JIRA_URL", .help = "Your Atlassian instance, like https://mycompany.atlassian.net" },
        .{ .key = "email", .label = "Atlassian account email", .kind = .email, .required = true, .env_fallback = "JIRA_EMAIL", .help = "The email you use to sign in to Jira. Pairs with the API token for HTTP Basic auth." },
        .{ .key = "api_token", .label = "Jira API token", .kind = .secret, .required = true, .env_fallback = "JIRA_API_TOKEN", .help_url = "https://id.atlassian.com/manage-profile/security/api-tokens", .help = "Create at id.atlassian.com → Security → API tokens. This is different from your Atlassian account password." },
    },
    .values_sources = .{
        .{ .id = "jira_work_values", .command = "mnml-jira --values --only work", .poll_interval_secs = 300 },
    },
    // An issue key in text mnml shows — a session card's name or its
    // output — links to the issue on your site. Any project's key: the
    // shape is Jira's, never a project's. `{site_url}` is filled in by
    // `--install` from config.zon's `.jira_url`, else by mnml from
    // $JIRA_URL (the site_url field's fallback above). Only this chip
    // declares it: the other two are the same site.
    .links = .{
        .{ .pattern = "[A-Z][A-Z0-9]+-\\d+", .url = "{site_url}/browse/{0}" },
    },
}
