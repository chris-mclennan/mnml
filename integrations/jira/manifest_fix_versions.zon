// The Jira Fix Versions manifest — one of the three chips the Jira integration
// ships, each opening the same binary on one family of tabs
// (`--only fix-versions`), the way the reference tracker's three launcher
// manifests do. `mnml-jira --install` writes all three into mnml's
// data root; the INTEGRATIONS section's Dev tab reads `manifest.zon`
// beside build.zig to list the folder before anything is built.
.{
    .id = "jira_fix_versions",
    .label = "Jira Fix Versions",
    .description = "Jira: current release grouped by status, with linked PRs + pipelines",
    .version = "0.2.2",
    .binary = "mnml-jira",
    .category = "tracker",
    .chip = .{ .glyph = "\u{f1c18}", .fallback = "JV", .color = "green", .tooltip = "Jira Fix Versions", .in_palette_bar = false }, // MnmlSymbols: Atlassian release
    .commands = .{
        .{ .id = "jira_fix_versions.open", .title = "Jira Fix Versions: open", .args = .{ "--only", "fix-versions" }, .keys = .{"space i j v"} },
        .{ .id = "jira_fix_versions.refresh", .title = "Jira Fix Versions: republish the statusline count", .ex = "term mnml-jira --values --only fix-versions --workspace {{workspace}}" },
    },
    .auth = .{
        .{ .key = "site_url", .label = "Jira site URL", .kind = .url, .required = true, .env_fallback = "JIRA_URL", .help = "Your Atlassian instance, like https://mycompany.atlassian.net" },
        .{ .key = "email", .label = "Atlassian account email", .kind = .email, .required = true, .env_fallback = "JIRA_EMAIL", .help = "The email you use to sign in to Jira. Pairs with the API token for HTTP Basic auth." },
        .{ .key = "api_token", .label = "Jira API token", .kind = .secret, .required = true, .env_fallback = "JIRA_API_TOKEN", .help_url = "https://id.atlassian.com/manage-profile/security/api-tokens", .help = "Create at id.atlassian.com → Security → API tokens. This is different from your Atlassian account password." },
    },
    // No values source, and no statusline segment for one to feed.
    // `--values` answers one question — how many items are assigned to
    // you — whatever `--only` says, so a source here would have the
    // poller ask Jira the same thing three times every five minutes and
    // republish the Work chip three times with it. One binary, three
    // manifests, one poll.
}
