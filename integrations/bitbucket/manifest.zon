// The Bitbucket integration's first manifest, the PRs chip — one
// file, two readers: `mnml-bitbucket --install` writes it into mnml's
// data root (`@import`ed by main.zig, so the binary and the file cannot
// drift), and the INTEGRATIONS section's Dev tab reads it beside
// build.zig to list the folder before anything is built. The second
// chip, Pipelines, is `manifest_pipelines.zon` beside this one;
// `--install` writes both, as the reference ships two.
//
// The keys mirror the reference's `bitbucket_prs.toml`: the id, the
// label, the chip (Atlassian's pull-request mark, `BP`, blue, off the palette bar),
// the three open commands, the auth fields, the values source and the
// three statusline segments.
.{
    .id = "bitbucket_prs",
    .label = "Bitbucket PRs",
    .description = "Bitbucket: open + merged pull requests across the workspace",
    .version = "0.2.2",
    .binary = "mnml-bitbucket",
    .args = .{ "--only", "prs" },
    .category = "forge",
    .chip = .{ .glyph = "\u{f1c15}", .fallback = "BP", .color = "blue", .tooltip = "Bitbucket pull requests", .in_palette_bar = false }, // MnmlSymbols: Atlassian pull-request
    .commands = .{
        .{ .id = "bitbucket_prs.open", .title = "Bitbucket PRs: open", .keys = .{"space i b"} },
        .{ .id = "bitbucket_prs.open_mine", .title = "Bitbucket PRs: open (mine only)", .args = .{ "--only", "prs-mine" } },
        .{ .id = "bitbucket_prs.open_awaiting", .title = "Bitbucket PRs: open (awaiting my approval)", .args = .{ "--only", "prs-awaiting" } },
        .{ .id = "bitbucket_prs.refresh", .title = "Bitbucket PRs: refresh the statusline chip", .ex = "term mnml-bitbucket --refresh --workspace {{workspace}}" },
    },
    .statusline = .{
        .{ .id = "prs_mine", .text = "{chip} …", .color = "green", .click_command = "bitbucket_prs.open_mine", .priority = 60, .tooltip = "Bitbucket: open pull requests you authored, and how many are still unapproved. Hover after a poll for the live figures." },
        // The second figure. It rests blank: `--values` publishes it
        // only once the count has been taken, and a zero before then
        // would read as "nothing outstanding".
        .{ .id = "reviews_mine", .text = "", .color = "yellow", .click_command = "bitbucket_prs.open_mine", .priority = 59, .tooltip = "Bitbucket: review threads on your open pull requests that are neither resolved nor replied to." },
        // The third figure, and the one that is your move: pull
        // requests you are a reviewer on and have not voted. It rests
        // blank like the second: its mark is its own, not the chip's,
        // and a resting glyph that is not the chip's is the drift the
        // host's install audit flags — the binary publishes it with its
        // count. The tooltip's example names are invented.
        .{ .id = "reviews_pending", .text = "", .color = "orange", .click_command = "bitbucket_prs.open_awaiting", .priority = 58, .tooltip = "Bitbucket: open pull requests waiting on YOUR review \u{2014} \u{201c}Fix the login redirect\u{201d}, \u{201c}Bump the client timeout\u{201d}. Hover after a poll for the live names." },
    },
    .auth = .{
        .{ .key = "api_token", .label = "Bitbucket API token (recommended)", .kind = .secret, .env_fallback = "BITBUCKET_API_TOKEN", .help_url = "https://id.atlassian.com/manage-profile/security/api-tokens", .help = "Preferred. Atlassian scoped API token — fresh rate-limit bucket, per-integration revoke. Either this OR an app password is required." },
        .{ .key = "app_password", .label = "Bitbucket app password", .kind = .secret, .env_fallback = "BITBUCKET_APP_PASSWORD", .help_url = "https://bitbucket.org/account/settings/app-passwords/", .help = "Legacy path. Set this OR an api_token above (api_token wins if both are set). Scopes: Repositories:Read + Pull requests:Read + Pipelines:Read." },
        .{ .key = "username", .label = "Bitbucket username (optional)", .kind = .text, .env_fallback = "BITBUCKET_USERNAME", .help = "Optional. Only needed if your app password requires Basic auth (username + password); leave blank for token-only auth." },
        // Read by mnml alone, for the pull-request links below; the
        // binary reads its workspace from config.zon.
        .{ .key = "workspace", .label = "Bitbucket workspace (for PR links)", .kind = .text, .env_fallback = "BITBUCKET_WORKSPACE", .help = "Optional. The slug in bitbucket.org/<workspace>/<repo>. `--install` writes config.zon's workspace into the pull-request links; set this only when the integration has no config yet." },
    },
    .values_sources = .{
        .{ .id = "bitbucket_values", .command = "mnml-bitbucket --values", .poll_interval_secs = 300 },
    },
    // A pull request named the way people write one — `<repo>#<number>`,
    // `widget#42` — links to it in your workspace, wherever mnml shows
    // text. A bare `#42` names no repo and does not link, nor does a
    // `<repo>#<number>` inside a path or an `owner/repo#n` (that owner
    // may be another forge's). `{workspace}` is filled in by `--install`
    // from config.zon's `.workspace`, which also narrows `<repo>` to the
    // config's `repos` when it lists any and adds `<workspace>/<repo>#n`;
    // else mnml binds it from $BITBUCKET_WORKSPACE (the workspace field's
    // fallback above).
    //
    // A bare number names no repo — `Pull request 5505`, `PR #5505`,
    // `pipeline 10554` — so these three are `.resolve = .range`: each
    // `--values` poll publishes which numbers each repo is using (its
    // lowest and highest pull request and pipeline seen, kept in
    // cache/link-ranges.json), and mnml fills `{repo}` with the repo
    // whose range holds the number. Several repos: the link opens the
    // workspace's own first and its menu lists each. None: no link.
    .links = .{
        .{ .pattern = "(?<![/\\w.-])([A-Za-z0-9_.-]+)#(\\d+)", .url = "https://bitbucket.org/{workspace}/{1}/pull-requests/{2}", .kind = "pr" },
        .{ .pattern = "(?i)\\bpull request #?(\\d+)", .url = "https://bitbucket.org/{repo}/pull-requests/{1}", .resolve = .range, .ranges = "pr" },
        .{ .pattern = "(?i)\\bPR #?(\\d+)", .url = "https://bitbucket.org/{repo}/pull-requests/{1}", .resolve = .range, .ranges = "pr" },
        .{ .pattern = "(?i)\\bpipeline #?(\\d+)", .url = "https://bitbucket.org/{repo}/pipelines/results/{1}", .resolve = .range, .ranges = "pipeline" },
    },
}
