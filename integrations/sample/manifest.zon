// The sample integration's manifest — one file, two readers:
// `mnml-sample --install` writes it into mnml's data root
// (`@import`ed by main.zig, so the binary and the file cannot drift),
// and the INTEGRATIONS section's Dev tab reads it beside build.zig to
// list the folder before anything is built.
.{
    .id = "sample",
    .label = "Sample",
    .description = "The mnml-sdk sample: a live counter that answers keys and clicks",
    .version = "0.1.0",
    .binary = "mnml-sample",
    .category = "sample",
    .chip = .{ .glyph = "\u{f0c3}", .fallback = "S", .color = "teal", .tooltip = "Sample integration" }, // nf-fa-flask
    .commands = .{
        .{ .id = "sample.open", .title = "Sample: open the counter pane", .keys = .{"ctrl+k s"} },
        .{ .id = "sample.hello", .title = "Sample: say hello (a toast)", .ex = "echo Hello from the sample integration" },
        .{ .id = "sample.echo_ticket", .title = "Sample: echo a ticket key", .ex = "echo Sample saw {key}" },
        .{ .id = "sample.echo_pr", .title = "Sample: echo a pull request", .ex = "echo Sample saw {repo}#{n}" },
    },
    // Rows this integration adds to menus mnml builds for OTHER panes
    // and links (docs/SDK.md, *Menu contributions*): a Jira ticket's
    // row, a ticket link in a terminal, a Bitbucket pull request. The
    // host fills `{key}` / `{repo}` / `{n}` from what was clicked.
    .context_menu = .{
        .{ .target = .{ .kind = "ticket" }, .label = "Echo ticket key", .command = "sample.echo_ticket", .hover = "The sample's reference contribution: toasts the ticket's key." },
        .{ .target = .{ .kind = "pr" }, .label = "Echo pull request", .command = "sample.echo_pr", .when = "state!=DECLINED" },
    },
    .statusline = .{
        .{ .id = "chip", .text = "S·sample", .color = "teal", .click_command = "sample.open" },
    },
    .settings = .{
        .{ .key = "mood", .label = "Mood", .options = .{ "calm", "eager", "sleepy" }, .default = "calm", .help = "Reaches the binary as MNML_SETTING_MOOD" },
    },
    // A shape of text this integration knows how to link (docs/SDK.md,
    // *Links*): `SAMPLE-12` on a session card underlines, and a click
    // opens the address. `{0}` is the match. A real tracker's address
    // names its site as `{site_url}`, a key of `auth[]` or `settings[]`
    // that `--install` (or mnml, from the field's `env_fallback`) fills.
    .links = .{
        .{ .pattern = "SAMPLE-\\d+", .url = "https://example.com/sample/{0}" },
    },
}
